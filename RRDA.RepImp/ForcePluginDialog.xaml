<Window x:Class="RRDA.RepImp.ForcePluginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleziona plugin"
        Width="560" Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Messaggio -->
            <RowDefinition Height="8"/>
            <!-- Spaziatura -->
            <RowDefinition Height="*"/>
            <!-- ListBox -->
            <RowDefinition Height="8"/>
            <!-- Spaziatura -->
            <RowDefinition Height="Auto"/>
            <!-- Bottoni -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"><Run Text="Seleziona il "/><Run Language="it-it" Text="plugin da utilizzare per l'importazione"/><Run Text=":"/></TextBlock>

        <ListBox x:Name="PluginsListBox"
                 Grid.Row="2"
                 SelectionChanged="PluginsListBox_SelectionChanged"
                 DisplayMemberPath="Name"
                 MouseDoubleClick="PluginsListBox_MouseDoubleClick"
                 HorizontalContentAlignment="Stretch"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="OkButton"
                    Content="Conferma"
                    Width="90"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    IsDefault="True"
                    Click="OkButton_Click"/>
            <Button x:Name="CancelButton"
                    Content="Annulla"
                    Width="90"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
