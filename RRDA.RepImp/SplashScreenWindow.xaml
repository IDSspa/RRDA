<Window x:Class="RRDA.RepImp.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RRDA"
        Height="420" Width="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True">

    <Window.Resources>
        <!-- Animazione fade-in all'avvio -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.5"
                             EasingFunction="{x:Null}" />
        </Storyboard>

        <!-- Animazione fade-out alla chiusura -->
        <Storyboard x:Key="FadeOut" Completed="FadeOut_Completed">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0"
                             Duration="0:0:0.4" />
        </Storyboard>

        <!-- Animazione progress bar -->
        <Storyboard x:Key="ProgressAnim">
            <DoubleAnimation Storyboard.TargetName="ProgressFill"
                             Storyboard.TargetProperty="Width"
                             From="0" To="620"
                             Duration="0:0:2"
                             EasingFunction="{x:Null}" />
        </Storyboard>

        <!-- Pulse sul logo -->
        <Storyboard x:Key="LogoPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LogoGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0.85"
                             Duration="0:0:1.1" />
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeIn}" />
            <BeginStoryboard Storyboard="{StaticResource ProgressAnim}" />
            <BeginStoryboard Storyboard="{StaticResource LogoPulse}" />
        </EventTrigger>
    </Window.Triggers>

    <!-- Ombra esterna tramite wrapper -->
    <Border x:Name="RootBorder"
            Opacity="0"
            Margin="10"
            CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="28"
                              ShadowDepth="6"
                              Opacity="0.55"
                              Direction="270" />
        </Border.Effect>

        <!-- Corpo principale -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Background con gradiente scuro industriale -->
            <Border Grid.RowSpan="2" CornerRadius="4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D1117" Offset="0" />
                        <GradientStop Color="#161B22" Offset="0.5" />
                        <GradientStop Color="#0D1117" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Accent line superiore -->
            <Rectangle VerticalAlignment="Top"
                       Height="3"
                       HorizontalAlignment="Stretch"
                       RadiusX="4" RadiusY="4">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00D4FF" Offset="0" />
                        <GradientStop Color="#0080FF" Offset="0.5" />
                        <GradientStop Color="#00D4FF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Griglia decorativa sfondo -->
            <Canvas Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True" Opacity="0.04">
                <!-- Linee verticali -->
                <Line X1="100" Y1="0" X2="100" Y2="420" Stroke="White" StrokeThickness="1"/>
                <Line X1="200" Y1="0" X2="200" Y2="420" Stroke="White" StrokeThickness="1"/>
                <Line X1="300" Y1="0" X2="300" Y2="420" Stroke="White" StrokeThickness="1"/>
                <Line X1="400" Y1="0" X2="400" Y2="420" Stroke="White" StrokeThickness="1"/>
                <Line X1="500" Y1="0" X2="500" Y2="420" Stroke="White" StrokeThickness="1"/>
                <Line X1="600" Y1="0" X2="600" Y2="420" Stroke="White" StrokeThickness="1"/>
                <!-- Linee orizzontali -->
                <Line X1="0" Y1="70"  X2="700" Y2="70"  Stroke="White" StrokeThickness="1"/>
                <Line X1="0" Y1="140" X2="700" Y2="140" Stroke="White" StrokeThickness="1"/>
                <Line X1="0" Y1="210" X2="700" Y2="210" Stroke="White" StrokeThickness="1"/>
                <Line X1="0" Y1="280" X2="700" Y2="280" Stroke="White" StrokeThickness="1"/>
                <Line X1="0" Y1="350" X2="700" Y2="350" Stroke="White" StrokeThickness="1"/>
            </Canvas>

            <!-- Contenuto centrale -->
            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="40,30,40,20">

                <!-- Logo / Titolo con glow -->
                <Grid HorizontalAlignment="Center">
                    <!-- Glow layer -->
                    <TextBlock x:Name="LogoGlow"
                               Text="RRDA"
                               FontFamily="Segoe UI Light"
                               FontSize="88"
                               FontWeight="Thin"
                               Foreground="#2090FF"
                               HorizontalAlignment="Center"
                               Opacity="0.3">
                        <TextBlock.Effect>
                            <BlurEffect Radius="18" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <!-- Testo principale -->
                    <TextBlock Text="RRDA"
                               FontFamily="Segoe UI Light"
                               FontSize="88"
                               FontWeight="Thin"
                               HorizontalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFF" Offset="0" />
                                <GradientStop Color="#A0C8FF" Offset="1" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                </Grid>

                <!-- Sottotitolo -->
                <TextBlock Text="Railway Report Data Analysis"
                           FontFamily="Consolas"
                           FontSize="13"
                           Foreground="#5A8ABB"
                           HorizontalAlignment="Center"                    
                           Margin="0,-8,0,0" />

                <!-- Separatore decorativo -->
                <Grid Margin="0,22,0,20" HorizontalAlignment="Center" Width="320">
                    <Rectangle Height="1" Fill="#1E3A5A" />
                    <Ellipse Width="6" Height="6"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Fill="#00D4FF" />
                </Grid>

                <!-- Versione e build info -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,4">
                    <Border Background="#0D2035"
                            CornerRadius="2"
                            Padding="8,3"
                            Margin="0,0,8,0">
                        <TextBlock Text="v1.0.0"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#00D4FF" />
                    </Border>
                    <Border Background="#0D2035"
                            CornerRadius="2"
                            Padding="8,3">
                        <TextBlock Text=".NET 8.0"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="#5A8ABB" />
                    </Border>
                </StackPanel>

            </StackPanel>

            <!-- Footer con progress bar -->
            <Grid Grid.Row="1" Margin="40,0,40,28">

                <!-- Testo di stato -->
                <TextBlock x:Name="StatusText"
                           Text="Inizializzazione in corso..."
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="#3A6080"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,8" />

                <TextBlock Text="© 2025 IDS"
                           FontFamily="Consolas"
                           FontSize="10"
                           Foreground="#1E3A5A"
                           HorizontalAlignment="Right"
                           Margin="0,0,0,8" />

                <!-- Track progress bar -->
                <Border Height="3"
                        CornerRadius="2"
                        Background="#0D2035"
                        VerticalAlignment="Bottom"
                        Margin="0,20,0,0">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,620,3" RadiusX="2" RadiusY="2"/>
                    </Border.Clip>

                    <!-- Fill animato -->
                    <Rectangle x:Name="ProgressFill"
                               Width="0"
                               Height="3"
                               HorizontalAlignment="Left"
                               RadiusX="2" RadiusY="2">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0050A0" Offset="0" />
                                <GradientStop Color="#00D4FF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
