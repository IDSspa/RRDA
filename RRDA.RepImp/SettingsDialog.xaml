<Window x:Class="RRDA.RepImp.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impostazioni RRDA RepImp" Height="390" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/> <!-- RecurseDepth row -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Cartella Reports:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="ReportsFolderTextBox" Grid.Row="0" Grid.Column="1" Margin="0,4,6,4"/>
        <Button x:Name="BrowseReportsButton" Grid.Row="0" Grid.Column="2" Content="Sfoglia..." Width="80" Click="BrowseReportsButton_Click" Margin="0,4,0,4"/>

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"><Run Text="Profondit"/><Run Language="it-it" Text="a"/><Run Text=" ricorsione:"/></TextBlock>
        <TextBox x:Name="RecurseDepthTextBox" Grid.Row="1" Grid.Column="1" Width="80" Margin="0,4,6,4" HorizontalAlignment="Left" ToolTip="Numero intero >= 0 (0 = non ricorsivo)"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Cartella Plugins:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="PluginsFolderTextBox" Grid.Row="2" Grid.Column="1" Margin="0,4,6,4"/>
        <Button x:Name="BrowsePluginsButton" Grid.Row="2" Grid.Column="2" Content="Sfoglia..." Width="80" Click="BrowsePluginsButton_Click" Margin="0,4,0,4"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Mapping unità:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="UnitMappingsTextBox" Grid.Row="3" Grid.Column="1" Margin="0,4,6,4"/>
        <Button x:Name="BrowseUnitMappingsButton" Grid.Row="3" Grid.Column="2" Content="Sfoglia..." Width="80" Click="BrowseUnitMappingsButton_Click" Margin="0,4,0,4"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Banlist importazione:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="ImportBanListTextBox" Grid.Row="4" Grid.Column="1" Margin="0,4,6,4"/>
        <Button x:Name="BrowseImportBanListButton" Grid.Row="4" Grid.Column="2" Content="Sfoglia..." Width="80" Click="BrowseImportBanListButton_Click" Margin="0,4,0,4"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="ConnectionString:" VerticalAlignment="Top" Margin="0,6,8,0"/>
        <TextBox x:Name="ConnectionStringTextBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0" AcceptsReturn="True" Height="80" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="SaveButton" Content="Salva" Width="90" Margin="0,0,8,0" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Annulla" Width="90" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
