<Window x:Class="RRDA.RepImp.BatchCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuovo batch"
        Width="460" Height="290"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Il batch verrà creato sul server e associato ai file importati."
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Nome:"/>
        <TextBox x:Name="NameTextBox" Grid.Row="1" Grid.Column="1" MaxLength="200"/>
        <TextBlock Grid.Row="3" VerticalAlignment="Top" Text="Descrizione:"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="3" Grid.Column="1" Grid.RowSpan="2"
                 MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>
        <CheckBox x:Name="MaintenanceCheckBox" Grid.Row="5" Grid.Column="1"
                  Content="Batch di manutenzione" Margin="0,10,0,12"/>
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Crea e usa" Width="100" Margin="0,0,8,0" IsDefault="True" Click="CreateButton_Click"/>
            <Button Content="Annulla" Width="90" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
