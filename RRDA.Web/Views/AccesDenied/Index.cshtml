@{
    ViewData["Title"] = "Accesso negato";
    Layout = null; // pagina standalone, nessuna sidebar
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Accesso negato — RRDA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: #0d1117;
            color: #c9d1d9;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }
        .card-denied {
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 8px;
            padding: 2.5rem 3rem;
            max-width: 480px;
            text-align: center;
        }
        .icon { font-size: 3rem; margin-bottom: 1rem; }
        .username {
            font-family: monospace;
            background: #0d2035;
            border-radius: 4px;
            padding: 2px 8px;
            color: #58a6ff;
        }
        h1 { font-size: 1.5rem; margin-bottom: 0.5rem; }
        p  { color: #8b949e; font-size: 0.95rem; }
    </style>
</head>
<body>
    <div class="card-denied">
        <div class="icon">🔒</div>
        <h1>Accesso non autorizzato</h1>
        <p>
            L'account <span class="username">@ViewBag.WindowsUser</span>
            non è registrato in RRDA oppure è stato disabilitato.
        </p>
        <p>Contattare un amministratore per richiedere l'accesso.</p>
    </div>
</body>
</html>
