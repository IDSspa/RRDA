@{
    ViewData["Title"] = "Help online";
}

<div class="d-flex align-items-center mb-4" style="gap:.75rem;">
    <div>
        <h4 style="margin:0;color:#c9d1d9;font-weight:600;">Help online</h4>
        <div class="rrda-muted mt-1">Manuali e riferimenti per le applicazioni RRDA.</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-lg-6">
        <section class="rrda-card h-100">
            <div class="d-flex align-items-start gap-3">
                <span class="help-icon">🌐</span>
                <div>
                    <h5 class="mb-2">RRDA.Web</h5>
                    <p class="rrda-muted mb-0">Manuale online dell'applicazione web. I contenuti saranno pubblicati progressivamente.</p>
                </div>
            </div>
        </section>
    </div>

    <div class="col-12 col-lg-6">
        <section class="rrda-card h-100">
            <div class="d-flex align-items-start gap-3">
                <span class="help-icon">🖥️</span>
                <div class="w-100">
                    <h5 class="mb-2">RRDA.RepImp</h5>
                    <p class="rrda-muted">Manuale dell'applicazione desktop per la generazione e l'importazione dei report.</p>
                    <div class="list-group list-group-flush help-topic-list">
                        <span class="list-group-item">Installazione <small>In preparazione</small></span>
                        <a asp-action="RepImpValidators" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span>Validatori</span><span aria-hidden="true">→</span>
                        </a>
                        <span class="list-group-item">Importazione <small>In preparazione</small></span>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<style>
    .help-icon { font-size: 1.5rem; line-height: 1; }
    .help-topic-list { border-top: 1px solid #21262d; }
    .help-topic-list .list-group-item {
        padding: .65rem 0;
        background: transparent;
        border-color: #21262d;
        color: #c9d1d9;
    }
    .help-topic-list a { color: #58a6ff !important; text-decoration: none; }
    .help-topic-list small { color: #8b949e; margin-left: .4rem; }
    html[data-theme="light"] .help-topic-list { border-color: #dbe3ec; }
    html[data-theme="light"] .help-topic-list .list-group-item { border-color: #dbe3ec; color: #263449; }
    html[data-theme="light"] .help-topic-list small { color: #64748b; }
</style>
