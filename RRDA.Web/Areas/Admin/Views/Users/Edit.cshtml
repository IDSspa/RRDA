@model RRDA.Data.AppUser
@using RRDA.Data

@{
    ViewData["Title"] = "Modifica utente";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" style="color:#8b949e;text-decoration:none;font-size:.85rem;">
        ← Utenti
    </a>
    <h4 style="margin:0;color:#c9d1d9;font-weight:600;">Modifica utente</h4>
</div>

<div class="rrda-card" style="max-width:520px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="CreatedAt" type="hidden" />
        <input asp-for="LastLoginAt" type="hidden" />

        <div class="mb-3">
            <label asp-for="WindowsUsername" class="form-label">Username Windows</label>
            <input asp-for="WindowsUsername" class="form-control" autocomplete="off" />
            <span asp-validation-for="WindowsUsername"
                  style="color:#f85149;font-size:.8rem;"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DisplayName" class="form-label">Nome visualizzato (opzionale)</label>
            <input asp-for="DisplayName" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Role" class="form-label">Ruolo</label>
            <select asp-for="Role" class="form-select"
                    asp-items="Html.GetEnumSelectList<AppUserRole>()">
            </select>
        </div>

        <div class="mb-3" style="color:#8b949e;font-size:.8rem;">
            Creato il: @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC
            @if (Model.LastLoginAt.HasValue)
            {
                <span style="margin-left:1rem;">
                    Ultimo accesso: @Model.LastLoginAt.Value.ToString("yyyy-MM-dd HH:mm") UTC
                </span>
            }
        </div>

        <div class="mb-4">
            <div class="form-check" style="display:flex;align-items:center;gap:.5rem;">
                <input asp-for="IsEnabled" class="form-check-input" type="checkbox"
                       style="width:16px;height:16px;cursor:pointer;" />
                <label asp-for="IsEnabled" class="form-label" style="margin:0;cursor:pointer;">
                    Utente abilitato
                </label>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-rrda-primary">Salva modifiche</button>
            <a asp-action="Index"
               style="color:#8b949e;text-decoration:none;padding:.35rem .85rem;font-size:.85rem;">
                Annulla
            </a>
        </div>
    </form>
</div>
