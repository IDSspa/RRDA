@model RRDA.Data.AppUser
@using RRDA.Data

@{
    ViewData["Title"] = "Nuovo utente";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" style="color:#8b949e;text-decoration:none;font-size:.85rem;">
        ← Utenti
    </a>
    <h4 style="margin:0;color:#c9d1d9;font-weight:600;">Nuovo utente</h4>
</div>

<div class="rrda-card" style="max-width:520px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="WindowsUsername" class="form-label">Username Windows</label>
            <input asp-for="WindowsUsername" class="form-control"
                   placeholder="DOMINIO\nomeutente" autocomplete="off" />
            <span asp-validation-for="WindowsUsername"
                  style="color:#f85149;font-size:.8rem;"></span>
            <div style="color:#484f58;font-size:.78rem;margin-top:.3rem;">
                Formato: DOMINIO\nomeutente oppure nomeutente per workgroup
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="DisplayName" class="form-label">Nome visualizzato (opzionale)</label>
            <input asp-for="DisplayName" class="form-control"
                   placeholder="Es: Mario Rossi" />
        </div>

        <div class="mb-3">
            <label asp-for="Role" class="form-label">Ruolo</label>
            <select asp-for="Role" class="form-select"
                    asp-items="Html.GetEnumSelectList<AppUserRole>()">
            </select>
        </div>

        <div class="mb-4">
            <div class="form-check" style="display:flex;align-items:center;gap:.5rem;">
                <input asp-for="IsEnabled" class="form-check-input" type="checkbox"
                       style="width:16px;height:16px;cursor:pointer;" />
                <label asp-for="IsEnabled" class="form-label" style="margin:0;cursor:pointer;">
                    Utente abilitato
                </label>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-rrda-primary">Crea utente</button>
            <a asp-action="Index"
               style="color:#8b949e;text-decoration:none;padding:.35rem .85rem;font-size:.85rem;">
                Annulla
            </a>
        </div>
    </form>
</div>
