@model RRDA.Web.Areas.Admin.Controllers.AuditIndexViewModel

@{
    ViewData["Title"] = "Audit log";
    var firstPage = Math.Max(1, Model.Page - 3);
    var lastPage = Math.Min(Model.TotalPages, Model.Page + 3);
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h4 style="margin:0;color:#c9d1d9;font-weight:600;">Audit log</h4>
        <div style="color:#8b949e;font-size:.82rem;margin-top:.25rem;">
            Operazioni applicative registrate da RRDA.Web e RRDA.RepImp
        </div>
    </div>
    <span style="color:#8b949e;font-size:.82rem;">@Model.TotalCount eventi</span>
</div>

<div class="rrda-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Applicazione</label>
            <select name="application" class="form-select">
                <option value="">Tutte</option>
                @foreach (var value in Model.Applications)
                {
                    <option value="@value" selected="@(value == Model.Application)">@value</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Operazione</label>
            <input name="operation" class="form-control" value="@Model.Operation" placeholder="Report.Import..." />
        </div>
        <div class="col-md-2">
            <label class="form-label">Esito</label>
            <select name="result" class="form-select">
                <option value="">Tutti</option>
                @foreach (var value in Model.Results)
                {
                    <option value="@value" selected="@(value == Model.Result)">@value</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Utente</label>
            <input name="userName" class="form-control" value="@Model.UserName" placeholder="DOMINIO\\utente" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Dal</label>
            <input type="date" name="from" class="form-control" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Al</label>
            <input type="date" name="to" class="form-control" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12 d-flex align-items-center gap-2 mt-3">
            <button type="submit" class="btn-rrda-primary">Filtra</button>
            <a asp-action="Index" style="color:#8b949e;text-decoration:none;padding:.35rem .85rem;font-size:.85rem;">Reset</a>
            <label class="form-label ms-auto mb-0">Eventi per pagina</label>
            <select name="pageSize" class="form-select" style="width:auto;" onchange="this.form.submit()">
                @foreach (var size in new[] { 25, 50, 100 })
                {
                    <option value="@size" selected="@(size == Model.PageSize)">@size</option>
                }
            </select>
        </div>
    </form>
</div>

<div class="rrda-card" style="overflow-x:auto;">
    @if (Model.Events.Count == 0)
    {
        <p style="color:#484f58;font-size:.875rem;margin:0;">Nessun evento audit trovato.</p>
    }
    else
    {
        <table class="table table-borderless mb-0">
            <thead>
                <tr>
                    <th>Data</th><th>Applicazione</th><th>Operazione</th><th>Esito</th>
                    <th>Utente</th><th>Entita</th><th>Descrizione</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var auditEvent in Model.Events)
                {
                    var resultColor = auditEvent.Result switch
                    {
                        "Success" => "#3fb950",
                        "Warning" or "Blocked" or "Rejected" or "Cancelled" => "#d29922",
                        _ => "#f85149"
                    };
                    var detailsId = $"audit-{auditEvent.Id}";
                    <tr>
                        <td style="white-space:nowrap;color:#8b949e;font-size:.8rem;">@auditEvent.OccurredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td style="font-family:monospace;font-size:.8rem;color:#58a6ff;">@auditEvent.Application</td>
                        <td style="font-family:monospace;font-size:.8rem;">@auditEvent.Operation</td>
                        <td><span class="badge-pill" style="color:@resultColor;border:1px solid @resultColor;">@auditEvent.Result</span></td>
                        <td style="font-size:.8rem;color:#8b949e;">@(auditEvent.UserName ?? "-")</td>
                        <td style="font-size:.8rem;">
                            <span>@(auditEvent.EntityType ?? "-")</span>
                            <span style="font-family:monospace;color:#8b949e;">@auditEvent.EntityId</span>
                        </td>
                        <td style="font-size:.8rem;max-width:24rem;">@(auditEvent.Description ?? "-")</td>
                        <td class="text-end">
                            <button type="button" data-bs-toggle="collapse" data-bs-target="#@detailsId"
                                    style="background:none;border:none;color:#58a6ff;font-size:.8rem;padding:0;">Dettagli</button>
                        </td>
                    </tr>
                    <tr class="collapse" id="@detailsId">
                        <td colspan="8" style="background:#0d1117;padding:1rem;">
                            <div class="row g-2" style="font-size:.8rem;color:#8b949e;">
                                <div class="col-md-3"><strong>Macchina:</strong> @auditEvent.MachineName</div>
                                <div class="col-md-3"><strong>IP:</strong> @(auditEvent.ClientIp ?? "-")</div>
                                <div class="col-md-6"><strong>Correlation ID:</strong> @(auditEvent.CorrelationId ?? "-")</div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(auditEvent.DetailsJson))
                            {
                                <pre style="margin:.75rem 0 0;white-space:pre-wrap;color:#c9d1d9;font-size:.78rem;">@auditEvent.DetailsJson</pre>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-center gap-1 mt-3">
                @for (var p = firstPage; p <= lastPage; p++)
                {
                    var active = p == Model.Page;
                    <a asp-action="Index" asp-route-page="@p" asp-route-pageSize="@Model.PageSize"
                       asp-route-application="@Model.Application" asp-route-operation="@Model.Operation"
                       asp-route-result="@Model.Result" asp-route-userName="@Model.UserName"
                       asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")"
                       style="padding:.25rem .6rem;border-radius:4px;font-size:.82rem;text-decoration:none;
                              background:@(active ? "#1f6feb" : "transparent");color:@(active ? "#fff" : "#8b949e");
                              border:1px solid @(active ? "#1f6feb" : "#30363d");">@p</a>
                }
            </div>
        }
    }
</div>
