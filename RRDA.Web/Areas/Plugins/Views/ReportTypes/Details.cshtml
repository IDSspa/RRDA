@model RRDA.Data.ReportType

@{
    ViewData["Title"] = $"Tipo: {Model.Key}";
    int fileCount = ViewBag.FileCount ?? 0;
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" style="color:#8b949e;text-decoration:none;font-size:.85rem;">
        ← Tipi di report
    </a>
    <h4 style="margin:0;color:#c9d1d9;font-weight:600;">@Model.Key</h4>
    <span style="color:#8b949e;font-size:.85rem;">@Model.Name</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="rrda-card" style="border-left:3px solid #1f6feb;">
            <div style="font-size:1.4rem;font-weight:700;color:#c9d1d9;">@fileCount</div>
            <div style="font-size:.78rem;color:#8b949e;text-transform:uppercase;letter-spacing:.05em;">
                File importati totali
            </div>
        </div>
    </div>
</div>

<div class="rrda-card mb-3">
    <h6 style="color:#8b949e;font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.75rem;">
        Informazioni
    </h6>
    <div class="row g-2" style="font-size:.875rem;">
        <div class="col-3" style="color:#8b949e;">Chiave</div>
        <div class="col-9" style="font-family:monospace;">@Model.Key</div>
        <div class="col-3" style="color:#8b949e;">Nome</div>
        <div class="col-9">@Model.Name</div>
        <div class="col-3" style="color:#8b949e;">Soggetto</div>
        <div class="col-9">@Model.SubjectKind</div>
        <div class="col-3" style="color:#8b949e;">Descrizione</div>
        <div class="col-9" style="color:#8b949e;">
            @(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)
        </div>
    </div>
</div>

<div class="rrda-card mb-3">
    <h6 style="margin:0 0 .75rem 0;color:#c9d1d9;font-weight:600;">Analisi soggetto</h6>
    <a asp-area="Data" asp-controller="Tabular" asp-action="TypePivot" asp-route-reportTypeId="@Model.Id" id="typePivotLink" class="btn-rrda-primary" style="text-decoration:none;">Vista tabellare</a>
    <a asp-area="Data" asp-controller="Statistics" asp-action="Subject" asp-route-reportTypeId="@Model.Id" style="margin-left:1rem;color:#58a6ff;text-decoration:none;">Analisi statistiche →</a>
</div>

<div class="modal fade" id="typePivotLoadingModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="typePivotLoadingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:#161b22;border:1px solid #30363d;color:#c9d1d9;">
            <div class="modal-body" style="padding:1.5rem;">
                <div class="d-flex align-items-center gap-3">
                    <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                    <div>
                        <h6 id="typePivotLoadingModalLabel" style="margin:0 0 .35rem 0;color:#c9d1d9;font-weight:600;">Elaborazione vista tabellare</h6>
                        <p style="margin:0;color:#8b949e;font-size:.875rem;">
                            Preparazione dei dati in corso. L'operazione puo richiedere qualche istante in base al numero di record presenti.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="rrda-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 style="margin:0;color:#c9d1d9;font-weight:600;">Ultimi 10 file importati</h6>
        <a asp-area="Data" asp-controller="Files" asp-action="Index"
           asp-route-reportTypeId="@Model.Id"
           style="font-size:.82rem;color:#58a6ff;text-decoration:none;">
            Vedi tutti →
        </a>
    </div>

    @if (!Model.Files.Any())
    {
        <p style="color:#484f58;font-size:.875rem;margin:0;">Nessun file ancora importato.</p>
    }
    else
    {
        <table class="table table-borderless mb-0">
            <thead>
                <tr>
                    <th>Nome file</th>
                    <th>Importato da</th>
                    <th>Data</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model.Files)
                {
                    <tr>
                        <td style="font-family:monospace;font-size:.82rem;">@f.FileName</td>
                        <td style="color:#8b949e;">@(f.ImportedBy ?? "—")</td>
                        <td style="color:#8b949e;font-size:.82rem;">
                            @f.UploadedAt.ToString("yyyy-MM-dd HH:mm")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script>
        (() => {
            const typePivotLink = document.getElementById('typePivotLink');
            const loadingModalElement = document.getElementById('typePivotLoadingModal');

            if (!typePivotLink || !loadingModalElement || !window.bootstrap) {
                return;
            }

            const loadingModal = new bootstrap.Modal(loadingModalElement, {
                backdrop: 'static',
                keyboard: false
            });

            typePivotLink.addEventListener('click', (event) => {
                if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) {
                    return;
                }

                document.body.setAttribute('aria-busy', 'true');
                typePivotLink.setAttribute('aria-disabled', 'true');
                typePivotLink.style.pointerEvents = 'none';
                loadingModal.show();
            });
        })();
    </script>
}
