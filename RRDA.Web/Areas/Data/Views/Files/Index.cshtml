@model RRDA.Web.Areas.Data.Models.FilesIndexViewModel
@using RRDA.Web.Security

@{
    ViewData["Title"] = "File importati";
    var isSupervisor = User.HasClaim(c => c.Type == AppUserClaimsTransformation.AppRoleClaimType
        && (c.Value == "Supervisor" || c.Value == "Admin"));
    var firstPage = Math.Max(1, Model.CurrentPage - 3);
    var lastPage = Math.Min(Model.TotalPages, Model.CurrentPage + 3);
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h4 style="margin:0;color:#c9d1d9;font-weight:600;">File importati</h4>
    <div class="d-flex align-items-center gap-3">
        <span style="color:#8b949e;font-size:.82rem;">@Model.TotalCount risultati</span>
        @if (isSupervisor)
        {
            <button type="button" id="change-batch-selected" class="btn-rrda-primary" disabled
                    data-bs-toggle="modal" data-bs-target="#change-batch-modal">
                Cambia batch
            </button>
            <button type="submit" form="bulk-delete-form" id="delete-selected"
                    class="btn-rrda-danger" disabled>
                Elimina selezionati
            </button>
            <a asp-action="Import" class="btn-rrda-primary" style="text-decoration:none;">
                Importa report
            </a>
        }
    </div>
</div>

@if (isSupervisor)
{
    <div class="modal fade" id="change-batch-modal" tabindex="-1" aria-labelledby="change-batch-modal-title" aria-hidden="true">
        <div class="modal-dialog">
            <form id="change-batch-form" asp-action="ChangeBatch" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-content" style="background:#161b22;border-color:#30363d;color:#c9d1d9;">
                    <div class="modal-header" style="border-color:#30363d;">
                        <h5 class="modal-title" id="change-batch-modal-title">Cambia batch</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                    </div>
                    <div class="modal-body">
                        <p class="rrda-muted mb-3">Il nuovo batch verrà assegnato a <strong id="change-batch-selected-count" style="color:#c9d1d9;">0</strong> file selezionati.</p>
                        <label for="new-batch-id" class="form-label">Nuovo batch</label>
                        <select id="new-batch-id" name="batchId" class="form-select" required>
                            <option value="">— Seleziona un batch —</option>
                            @foreach (var batch in Model.BatchOptions)
                            {
                                <option value="@batch.Value">@batch.Text</option>
                            }
                        </select>
                        <div id="change-batch-selected-ids"></div>
                    </div>
                    <div class="modal-footer" style="border-color:#30363d;">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                        <button type="submit" class="btn-rrda-primary">Conferma cambio batch</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

<!-- ── Filtri ── -->
<div class="rrda-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label">Tipo di report</label>
            <select name="reportTypeId" class="form-select" asp-items="Model.ReportTypeOptions">
                <option value="">— Tutti —</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Batch</label>
            <select name="batchId" class="form-select" asp-items="Model.BatchOptions">
                <option value="">— Tutti —</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Nome file</label>
            <input type="text" name="fileName" class="form-control"
                   value="@Model.Filters.FileName" placeholder="es. *seriale*.xlsx" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Numero seriale</label>
            <input type="text" name="serialNumber" class="form-control"
                   value="@Model.Filters.SerialNumber" placeholder="es. SN-12*" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Importato da</label>
            <input type="text" name="importedBy" class="form-control"
                   value="@Model.Filters.ImportedBy" placeholder="username..." />
        </div>
        <div class="col-md-auto">
            <label class="form-label">Dal</label>
            <input type="date" name="from" class="form-control" style="width:10.5rem;color-scheme:dark;"
                   value="@Model.Filters.From" />
        </div>
        <div class="col-md-auto">
            <label class="form-label">Al</label>
            <input type="date" name="to" class="form-control" style="width:10.5rem;color-scheme:dark;"
                   value="@Model.Filters.To" />
        </div>
        <div class="col-md-auto d-flex gap-2">
            <button type="submit" class="btn-rrda-primary">Filtra</button>
            <a asp-action="Index" style="color:#8b949e;text-decoration:none;
               padding:.35rem .85rem;font-size:.85rem;">Reset</a>
        </div>
    </form>
</div>

<!-- ── Tabella ── -->
<div class="rrda-card">
    @if (!Model.Files.Any())
    {
        <p style="color:#484f58;font-size:.875rem;margin:0;">Nessun file trovato.</p>
    }
    else
    {
        <form id="bulk-delete-form" asp-action="DeleteSelected" method="post"
              onsubmit="return event.submitter?.id !== 'delete-selected' || confirm('Eliminare tutti i file selezionati e i relativi dati?')">
            @Html.AntiForgeryToken()
            <input type="hidden" name="reportTypeId" value="@Model.Filters.ReportTypeId" />
            <input type="hidden" name="batchId" value="@Model.Filters.BatchId" />
            <input type="hidden" name="fileName" value="@Model.Filters.FileName" />
            <input type="hidden" name="serialNumber" value="@Model.Filters.SerialNumber" />
            <input type="hidden" name="importedBy" value="@Model.Filters.ImportedBy" />
            <input type="hidden" name="from" value="@Model.Filters.From" />
            <input type="hidden" name="to" value="@Model.Filters.To" />
            <input type="hidden" name="page" value="@Model.CurrentPage" />
            <input type="hidden" name="pageSize" value="@Model.Filters.PageSize" />
        <table class="table table-borderless mb-0">
            <thead>
                <tr>
                    @if (isSupervisor)
                    {
                        <th style="width:2rem;">
                            <input type="checkbox" id="select-all" aria-label="Seleziona tutti i file della pagina" />
                        </th>
                    }
                    <th>Nome file</th>
                    <th>Numero seriale</th>
                    <th>Tipo</th>
                    <th>Batch</th>
                    <th>Importato da</th>
                    <th>Data importazione</th>
                    <th>Ultima modifica file</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Files)
                {
                    var f = item.File;
                    <tr>
                        @if (isSupervisor)
                        {
                            <td>
                                <input type="checkbox" class="row-selector" name="selectedIds"
                                       value="@f.Id" aria-label="Seleziona @f.FileName" />
                            </td>
                        }
                        <td style="font-family:monospace;font-size:.82rem;">
                            <a asp-action="Details" asp-route-id="@f.Id"
                               style="color:#c9d1d9;text-decoration:none;">
                                @f.FileName
                            </a>
                        </td>
                        <td style="font-family:monospace;font-size:.82rem;color:#c9d1d9;">
                            @(item.SerialNumber ?? "—")
                        </td>
                        <td>
                            <span class="badge-pill"
                                  style="background:#1f6feb22;color:#58a6ff;border:1px solid #1f6feb44;">
                                @f.ReportType?.Key
                            </span>
                        </td>
                        <td style="color:#8b949e;font-size:.82rem;">
                            @(f.ReportBatch?.Name ?? "—")
                        </td>
                        <td style="color:#8b949e;font-size:.85rem;">
                            @(f.ImportedBy ?? "—")
                        </td>
                        <td style="color:#8b949e;font-size:.82rem;">
                            @f.UploadedAt.ToString("yyyy-MM-dd HH:mm")
                        </td>

                        <td style="color:#8b949e;font-size:.82rem;">
                            @f.FileLastModify.ToString("yyyy-MM-dd HH:mm")
                        </td>

                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@f.Id"
                               style="color:#8b949e;font-size:.82rem;text-decoration:none;margin-right:.75rem;">
                                Dettagli
                            </a>
                            <a asp-action="Entities" asp-route-fileId="@f.Id"
                               style="color:#58a6ff;font-size:.82rem;text-decoration:none;margin-right:.75rem;">
                                Entità
                            </a>
                            @if (isSupervisor)
                            {
                                    <button type="submit" asp-action="Delete" asp-route-id="@f.Id"
                                            formnovalidate
                                            onclick="return confirm('Eliminare il file \'@f.FileName\' e tutti i dati associati?')"
                                        style="background:none;border:none;color:#f85149;font-size:.82rem;cursor:pointer;padding:0;">
                                        Elimina
                                    </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </form>

        <!-- ── Paginazione ── -->
        @if (Model.TotalPages > 1)
        {
            <nav class="d-flex justify-content-center flex-wrap gap-1 mt-3" aria-label="Paginazione file">
                @if (firstPage > 1)
                {
                    <a asp-action="Index"
                       asp-route-page="1"
                       asp-route-reportTypeId="@Model.Filters.ReportTypeId"
                       asp-route-batchId="@Model.Filters.BatchId"
                       asp-route-fileName="@Model.Filters.FileName"
                       asp-route-serialNumber="@Model.Filters.SerialNumber"
                       asp-route-importedBy="@Model.Filters.ImportedBy"
                       asp-route-from="@Model.Filters.From"
                       asp-route-to="@Model.Filters.To"
                       asp-route-pageSize="@Model.Filters.PageSize"
                       style="padding:.25rem .6rem;border-radius:4px;font-size:.82rem;text-decoration:none;
                              color:#8b949e;border:1px solid #30363d;">
                        1
                    </a>
                    @if (firstPage > 2)
                    {
                        <span class="px-1 align-self-center" style="color:#8b949e;">…</span>
                    }
                }
                @for (int p = firstPage; p <= lastPage; p++)
                {
                    var isActive = p == Model.CurrentPage;
                    <a asp-action="Index"
                       asp-route-page="@p"
                       asp-route-reportTypeId="@Model.Filters.ReportTypeId"
                       asp-route-batchId="@Model.Filters.BatchId"
                       asp-route-fileName="@Model.Filters.FileName"
                       asp-route-serialNumber="@Model.Filters.SerialNumber"
                       asp-route-importedBy="@Model.Filters.ImportedBy"
                       asp-route-from="@Model.Filters.From"
                       asp-route-to="@Model.Filters.To"
                       asp-route-pageSize="@Model.Filters.PageSize"
                       style="padding:.25rem .6rem;border-radius:4px;font-size:.82rem;
                              text-decoration:none;
                              background:@(isActive ? "#1f6feb" : "transparent");
                              color:@(isActive ? "#fff" : "#8b949e");
                              border:1px solid @(isActive ? "#1f6feb" : "#30363d");">
                        @p
                    </a>
                }
                @if (lastPage < Model.TotalPages)
                {
                    @if (lastPage < Model.TotalPages - 1)
                    {
                        <span class="px-1 align-self-center" style="color:#8b949e;">…</span>
                    }
                    <a asp-action="Index"
                       asp-route-page="@Model.TotalPages"
                       asp-route-reportTypeId="@Model.Filters.ReportTypeId"
                       asp-route-batchId="@Model.Filters.BatchId"
                       asp-route-fileName="@Model.Filters.FileName"
                       asp-route-serialNumber="@Model.Filters.SerialNumber"
                       asp-route-importedBy="@Model.Filters.ImportedBy"
                       asp-route-from="@Model.Filters.From"
                       asp-route-to="@Model.Filters.To"
                       asp-route-pageSize="@Model.Filters.PageSize"
                       style="padding:.25rem .6rem;border-radius:4px;font-size:.82rem;text-decoration:none;
                              color:#8b949e;border:1px solid #30363d;">
                        @Model.TotalPages
                    </a>
                }
            </nav>
        }
    }
</div>

@if (isSupervisor)
{
    <script>
        (() => {
            const selectAll = document.getElementById('select-all');
            const selectors = Array.from(document.querySelectorAll('.row-selector'));
            const deleteButton = document.getElementById('delete-selected');
            const changeBatchButton = document.getElementById('change-batch-selected');
            const changeBatchCount = document.getElementById('change-batch-selected-count');
            const changeBatchIds = document.getElementById('change-batch-selected-ids');

            if (!selectAll || !deleteButton || !changeBatchButton) {
                return;
            }

            const updateState = () => {
                const selectedCount = selectors.filter(selector => selector.checked).length;
                deleteButton.disabled = selectedCount === 0;
                changeBatchButton.disabled = selectedCount === 0;
                selectAll.checked = selectedCount > 0 && selectedCount === selectors.length;
                selectAll.indeterminate = selectedCount > 0 && selectedCount < selectors.length;
            };

            selectAll.addEventListener('change', () => {
                selectors.forEach(selector => selector.checked = selectAll.checked);
                updateState();
            });

            selectors.forEach(selector => selector.addEventListener('change', updateState));
            changeBatchButton.addEventListener('click', () => {
                const selectedIds = selectors.filter(selector => selector.checked).map(selector => selector.value);
                changeBatchCount.textContent = selectedIds.length;
                changeBatchIds.replaceChildren(...selectedIds.map(id => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'selectedIds';
                    input.value = id;
                    return input;
                }));
            });
            updateState();
        })();
    </script>
}
