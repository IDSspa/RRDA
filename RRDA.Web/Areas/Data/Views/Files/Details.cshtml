@model RRDA.Web.Areas.Data.Models.FileDetailsViewModel

@{
    ViewData["Title"] = $"File: {Model.File.FileName}";
}

<div class="d-flex align-items-center gap-3 mb-4">
    <a asp-action="Index" style="color:#8b949e;text-decoration:none;font-size:.85rem;">
        ← File importati
    </a>
    <h4 style="margin:0;color:#c9d1d9;font-weight:600;font-family:monospace;font-size:1rem;">
        @Model.File.FileName
    </h4>
</div>

<!-- ── Tile contatori ── -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="rrda-card" style="border-left:3px solid #1f6feb;">
            <div style="font-size:1.4rem;font-weight:700;color:#c9d1d9;">@Model.EntityCount</div>
            <div style="font-size:.78rem;color:#8b949e;text-transform:uppercase;letter-spacing:.05em;">
                Entità totali
            </div>
        </div>
    </div>
</div>

<!-- ── Informazioni file ── -->
<div class="rrda-card mb-3">
    <h6 style="color:#8b949e;font-size:.78rem;text-transform:uppercase;
               letter-spacing:.06em;margin-bottom:.75rem;">
        Informazioni
    </h6>
    <div class="row g-2" style="font-size:.875rem;">
        <div class="col-3" style="color:#8b949e;">Nome file</div>
        <div class="col-9" style="font-family:monospace;">@Model.File.FileName</div>

        <div class="col-3" style="color:#8b949e;">Percorso</div>
        <div class="col-9" style="font-family:monospace;font-size:.78rem;word-break:break-all;">
            @Model.File.FullPath
        </div>

        <div class="col-3" style="color:#8b949e;">Tipo di report</div>
        <div class="col-9">
            <span class="badge-pill"
                  style="background:#1f6feb22;color:#58a6ff;border:1px solid #1f6feb44;">
                @Model.File.ReportType?.Key
            </span>
        </div>

        <div class="col-3" style="color:#8b949e;">Importato da</div>
        <div class="col-9">@(Model.File.ImportedBy ?? "—")</div>

        <div class="col-3" style="color:#8b949e;">Data importazione</div>
        <div class="col-9">@Model.File.UploadedAt.ToString("yyyy-MM-dd HH:mm") UTC</div>

        <div class="col-3" style="color:#8b949e;">Ultima modifica file</div>
        <div class="col-9" style="font-family:monospace;">
            @Model.File.FileLastModify.ToString("yyyy-MM-dd HH:mm")
        </div>
    </div>
</div>

<!-- Correlazioni -->
<div class="rrda-card mb-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 style="margin:0;color:#c9d1d9;font-weight:600;">Correlazioni</h6>
        <span style="color:#8b949e;font-size:.78rem;">@Model.References.Count</span>
    </div>

    @if (Model.References.Count == 0)
    {
        <p style="color:#8b949e;font-size:.85rem;margin:0 0 1rem;">Nessuna correlazione presente.</p>
    }
    else
    {
        <table class="table table-borderless mb-3">
            <thead>
                <tr>
                    <th>Origine</th>
                    <th>Direzione</th>
                    <th>Campo</th>
                    <th>Report correlato</th>
                    <th>Stato</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reference in Model.References)
                {
                    <tr>
                        <td>@reference.Origin</td>
                        <td>@(reference.IsIncoming ? "In ingresso" : "In uscita")</td>
                        <td style="font-family:monospace;">@(reference.SourceField ?? "—")</td>
                        <td>
                            <span style="font-family:monospace;">@reference.TargetReportTypeKey</span>
                            @if (!string.IsNullOrWhiteSpace(reference.TargetKeyValue))
                            {
                                <span style="color:#8b949e;"> · @reference.TargetKeyValue</span>
                            }
                        </td>
                        <td>
                            @if (reference.Targets.Count == 0)
                            {
                                <span style="color:#d29922;">Non risolto</span>
                            }
                            else
                            {
                                @foreach (var target in reference.Targets)
                                {
                                    <a asp-action="Details" asp-route-id="@target.FileId"
                                       style="color:#58a6ff;text-decoration:none;margin-right:.5rem;">
                                        @target.FileName
                                    </a>
                                }
                            }
                        </td>
                        <td>
                            @if (Model.CanManageReferences
                                && !reference.IsIncoming
                                && reference.Origin == RRDA.Data.ReportReferenceOrigin.Manual)
                            {
                                <form asp-action="DeleteManualReference" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@reference.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Rimuovi</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.CanManageReferences && Model.ManualReferenceTargets.Count > 0)
    {
        <form asp-action="AddManualReference" method="post" class="d-flex gap-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="sourceReportFileId" value="@Model.File.Id" />
            <div style="min-width:320px;">
                <label class="form-label">Aggiungi collegamento manuale</label>
                <select class="form-select" name="targetReportFileId" asp-items="Model.ManualReferenceTargets"></select>
            </div>
            <button type="submit" class="btn-rrda-primary" style="border-radius:6px;padding:.45rem .9rem;">
                Collega
            </button>
        </form>
    }
</div>

<!-- ── Entità per tipo ── -->
<div class="rrda-card mb-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 style="margin:0;color:#c9d1d9;font-weight:600;">Entità per tipo</h6>
        <a asp-action="Entities" asp-route-fileId="@Model.File.Id"
           style="font-size:.82rem;color:#58a6ff;text-decoration:none;">
            Vedi tutte →
        </a>
    </div>
    <table class="table table-borderless mb-0">
        <thead>
            <tr>
                <th>EntityKind</th>
                <th>Conteggio</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var k in Model.EntityKinds)
            {
                <tr>
                    <td style="font-family:monospace;font-size:.85rem;">@k.Kind</td>
                    <td>
                        <span class="badge-pill"
                              style="background:#3fb95022;color:#3fb950;border:1px solid #3fb95044;">
                            @k.Count
                        </span>
                    </td>
                    <td>
                        <a asp-action="Entities"
                           asp-route-fileId="@Model.File.Id"
                           asp-route-kind="@k.Kind"
                           style="color:#58a6ff;font-size:.82rem;text-decoration:none;">
                            Visualizza
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- ── Azioni ── -->
<div class="d-flex gap-2">
    <a asp-action="Entities" asp-route-fileId="@Model.File.Id"
       class="btn-rrda-primary" style="text-decoration:none;padding:.4rem .9rem;border-radius:6px;">
        Vedi entità
    </a>

    <a asp-area="Data" asp-controller="Tabular" asp-action="FilePivot" asp-route-fileId="@Model.File.Id"
       style="color:#58a6ff;text-decoration:none;padding:.4rem .9rem;font-size:.85rem;border:1px solid #1f6feb44;border-radius:6px;">
        Vista orizzontale (Pivot)
    </a>

</div>
