@using System.Globalization
@model RRDA.Web.Areas.Data.Controllers.TypePivotViewModel
@{
    ViewData["Title"] = $"Type Pivot - {Model.ReportTypeKey}";
    var staticFooterColumns = Model.HasSubjectKey ? 5 : 4;

    string FormatStatistic(double? value)
    {
        return value.HasValue
            ? Math.Round(value.Value, Model.DecimalPlaces).ToString($"F{Model.DecimalPlaces}", CultureInfo.InvariantCulture)
            : "";
    }
}

<style>
    .type-pivot-header-btn {
        color: #c9d1d9;
        background: #161b22;
        border: 1px solid #30363d;
        font-family: monospace;
        font-size: .74rem;
        white-space: nowrap;
    }

    .type-pivot-header-btn:hover,
    .type-pivot-header-btn:focus,
    .type-pivot-header-btn.show {
        color: #f0f6fc;
        background: #21262d;
        border-color: #58a6ff;
        box-shadow: none;
    }
</style>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h4 style="margin:0;color:#c9d1d9;font-weight:600;">Vista orizzontale per tipo report: @Model.ReportTypeKey</h4>
    <div style="color:#8b949e;font-size:.85rem;">File totali: @Model.TotalFiles</div>
</div>

<div class="rrda-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <input type="hidden" name="reportTypeId" value="@Model.ReportTypeId" />

        <div class="col-md-3">
            <label class="form-label">Batch</label>
            <select class="form-select" name="batchId">
                <option value="">Tutti</option>
                @foreach (var batch in Model.BatchOptions)
                {
                    <option value="@batch.Id" selected="@(Model.BatchId == batch.Id)">@batch.Label</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Uploaded da</label>
            <input type="date" class="form-control" name="uploadedFrom" value="@(Model.UploadedFrom?.ToString("yyyy-MM-dd"))" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Uploaded a</label>
            <input type="date" class="form-control" name="uploadedTo" value="@(Model.UploadedTo?.ToString("yyyy-MM-dd"))" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Campo filtro</label>
            <select class="form-select" name="filterField">
                <option value="">--</option>
                @foreach (var f in Model.DynamicFilterFields)
                {
                    <option value="@f" selected="@(Model.FilterField == f)">@f</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Campo da</label>
            <input class="form-control" name="filterFrom" value="@Model.FilterFrom" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Campo a</label>
            <input class="form-control" name="filterTo" value="@Model.FilterTo" />
        </div>

        <div class="col-md-2">
            <label class="form-label">@Model.SubjectKeyLabel da</label>
            <input class="form-control" name="subjectKeyFrom" value="@Model.SubjectKeyFrom" />
        </div>

        <div class="col-md-2">
            <label class="form-label">@Model.SubjectKeyLabel a</label>
            <input class="form-control" name="subjectKeyTo" value="@Model.SubjectKeyTo" />
        </div>

        <div class="col-md-1">
            <button class="btn-rrda-primary" type="submit">Applica</button>
        </div>
    </form>
</div>

<div class="rrda-card" style="overflow:auto;">
    @if (!Model.Rows.Any())
    {
        <p style="color:#8b949e;margin:0;">Nessun file disponibile per questo report type.</p>
    }
    else
    {
        <table class="table table-borderless mb-0" style="min-width:1400px;">
            <thead>
                <tr>
                    @* ── SubjectKey: prima colonna, header semplice senza popup ── *@
                    @if (Model.HasSubjectKey)
                    {
                        <th style="font-family:monospace;font-size:.78rem;white-space:nowrap;">@Model.SubjectKeyLabel</th>
                    }
                    @* ── Colonne statiche file ── *@
                    <th>FileId</th>
                    <th>FileName</th>
                    <th>UploadedAt</th>
                    <th>BatchId</th>
                    @* ── Colonne di misura con popup statistico ── *@
                    @foreach (var header in Model.Headers)
                    {
                        var headerLabel = header;
                        if (Model.HeaderUnits.TryGetValue(header, out var unit)
                            && !string.IsNullOrWhiteSpace(unit))
                        {
                            headerLabel = $"{header} [{unit}]";
                        }

                        <th style="font-family:monospace;font-size:.78rem;">
                            <div class="dropdown">
                                <button class="btn btn-sm dropdown-toggle type-pivot-header-btn" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false">@headerLabel</button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Data"
                                           asp-controller="Statistics"
                                           asp-action="Distribution"
                                           asp-route-reportTypeId="@Model.ReportTypeId"
                                           asp-route-field="@header"
                                           asp-route-batchId="@Model.BatchId"
                                           asp-route-uploadedFrom="@(Model.UploadedFrom?.ToString("yyyy-MM-dd"))"
                                           asp-route-uploadedTo="@(Model.UploadedTo?.ToString("yyyy-MM-dd"))">
                                            Distribuzione
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#"
                                           onclick="alert('Diagramma di dispersione: vista in implementazione'); return false;">
                                            Diagramma di dispersione
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        @* ── SubjectKey: renderizzato come intero (o stringa se non numerico) ── *@
                        @if (Model.HasSubjectKey)
                        {
                            <td style="font-family:monospace;font-size:.78rem;white-space:nowrap;">
                                @{
                                    var skRaw = row.SubjectKey;
                                    if (!string.IsNullOrWhiteSpace(skRaw)
                                        && long.TryParse(skRaw, NumberStyles.Any, CultureInfo.InvariantCulture, out var skLong))
                                    {
                                        @skLong
                                    }
                                    else if (!string.IsNullOrWhiteSpace(skRaw)
                                             && double.TryParse(skRaw, NumberStyles.Any, CultureInfo.InvariantCulture, out var skDouble))
                                    {
                                        @((long)Math.Round(skDouble))
                                    }
                                    else
                                    {
                                        @(skRaw ?? "")
                                    }
                                }
                            </td>
                        }
                        @* ── Colonne statiche ── *@
                        <td>@row.FileId</td>
                        <td style="font-family:monospace;font-size:.78rem;">@row.FileName</td>
                        <td style="font-size:.78rem;">@row.UploadedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td style="font-size:.78rem;">@(row.BatchId?.ToString() ?? "—")</td>
                        @* ── Valori di misura: double con decimali configurati ── *@
                        @foreach (var header in Model.Headers)
                        {
                            <td style="font-family:monospace;font-size:.78rem;white-space:nowrap;">
                                @{
                                    if (row.Values.TryGetValue(header, out var value))
                                    {
                                        if (double.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out var dInv))
                                        {
                                            @Math.Round(dInv, Model.DecimalPlaces).ToString($"F{Model.DecimalPlaces}", CultureInfo.InvariantCulture)
                                        }
                                        else if (double.TryParse(value, NumberStyles.Any, CultureInfo.CurrentCulture, out var dCur))
                                        {
                                            @Math.Round(dCur, Model.DecimalPlaces).ToString($"F{Model.DecimalPlaces}", CultureInfo.CurrentCulture)
                                        }
                                        else
                                        {
                                            @(value ?? "")
                                        }
                                    }
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="@staticFooterColumns" style="font-size:.76rem;color:#8b949e;">Max</th>
                    @foreach (var header in Model.Headers)
                    {
                        Model.ColumnStatistics.TryGetValue(header, out var stats);
                        <td style="font-family:monospace;font-size:.76rem;white-space:nowrap;color:#c9d1d9;">
                            @FormatStatistic(stats?.Max)
                        </td>
                    }
                </tr>
                <tr>
                    <th colspan="@staticFooterColumns" style="font-size:.76rem;color:#8b949e;">Media</th>
                    @foreach (var header in Model.Headers)
                    {
                        Model.ColumnStatistics.TryGetValue(header, out var stats);
                        <td style="font-family:monospace;font-size:.76rem;white-space:nowrap;color:#c9d1d9;">
                            @FormatStatistic(stats?.Mean)
                        </td>
                    }
                </tr>
                <tr>
                    <th colspan="@staticFooterColumns" style="font-size:.76rem;color:#8b949e;">Min</th>
                    @foreach (var header in Model.Headers)
                    {
                        Model.ColumnStatistics.TryGetValue(header, out var stats);
                        <td style="font-family:monospace;font-size:.76rem;white-space:nowrap;color:#c9d1d9;">
                            @FormatStatistic(stats?.Min)
                        </td>
                    }
                </tr>
@*                 <tr>
                    <th colspan="@staticFooterColumns" style="font-size:.76rem;color:#8b949e;">Mediana</th>
                    @foreach (var header in Model.Headers)
                    {
                        Model.ColumnStatistics.TryGetValue(header, out var stats);
                        <td style="font-family:monospace;font-size:.76rem;white-space:nowrap;color:#c9d1d9;">
                            @FormatStatistic(stats?.Median)
                        </td>
                    }
                </tr> *@
                <tr>
                    <th colspan="@staticFooterColumns" style="font-size:.76rem;color:#8b949e;">Dev. std</th>
                    @foreach (var header in Model.Headers)
                    {
                        Model.ColumnStatistics.TryGetValue(header, out var stats);
                        <td style="font-family:monospace;font-size:.76rem;white-space:nowrap;color:#c9d1d9;">
                            @FormatStatistic(stats?.StandardDeviation)
                        </td>
                    }
                </tr>
            </tfoot>
        </table>
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="d-flex gap-2 mt-3">
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <a asp-action="TypePivot"
               asp-route-reportTypeId="@Model.ReportTypeId"
               asp-route-page="@p"
               asp-route-pageSize="@Model.PageSize"
               asp-route-batchId="@Model.BatchId"
               asp-route-uploadedFrom="@(Model.UploadedFrom?.ToString("yyyy-MM-dd"))"
               asp-route-uploadedTo="@(Model.UploadedTo?.ToString("yyyy-MM-dd"))"
               asp-route-filterField="@Model.FilterField"
               asp-route-filterFrom="@Model.FilterFrom"
               asp-route-filterTo="@Model.FilterTo"
               asp-route-subjectKeyFrom="@Model.SubjectKeyFrom"
               asp-route-subjectKeyTo="@Model.SubjectKeyTo"
               style="padding:.2rem .55rem;border:1px solid #30363d;border-radius:5px;
                      text-decoration:none;color:@(p == Model.CurrentPage ? "#58a6ff" : "#8b949e");">
                @p
            </a>
        }
    </div>
}
