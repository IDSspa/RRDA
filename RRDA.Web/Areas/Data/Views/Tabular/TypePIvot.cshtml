@using System.Globalization
@model RRDA.Web.Areas.Data.Controllers.TypePivotViewModel
@{
    ViewData["Title"] = $"Type Pivot - {Model.ReportTypeKey}";
    var staticFooterColumns = Model.HasSubjectKey ? 5 : 4;

    string FormatStatistic(double? value)
    {
        return value.HasValue
            ? Math.Round(value.Value, Model.DecimalPlaces).ToString($"F{Model.DecimalPlaces}", CultureInfo.InvariantCulture)
            : "";
    }
}

<style>
    .type-pivot-table td, .type-pivot-table th {
        padding: .25rem .5rem;
    }

    .type-pivot-header-btn {
        color: #c9d1d9;
        background: #161b22;
        border: 1px solid #30363d;
        font-family: monospace;
        font-size: .74rem;
        white-space: nowrap;
    }

    .type-pivot-header-btn:hover,
    .type-pivot-header-btn:focus,
    .type-pivot-header-btn.show {
        color: #f0f6fc;
        background: #21262d;
        border-color: #58a6ff;
        box-shadow: none;
        }

    .sort-indicator {
        display: inline-block;
        margin-left: 0.25rem;
        font-size: 0.75rem;
    }

    .sort-asc::after {
        content: " ▲";
    }

    .sort-desc::after {
        content: " ▼";
    }

    /* Zebra stripe styling for improved readability */
    .type-pivot-table tbody tr:nth-child(odd) {
        background-color: #0d1117;
    }

    .type-pivot-table tbody tr:nth-child(even) {
        background-color: #1c2128;
    }

    .type-pivot-table tbody tr:hover {
        background-color: #262c36;
    }

    .type-pivot-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .type-pivot-toolbar-title {
        color: #c9d1d9;
        font-weight: 600;
        margin: 0;
    }

    .type-pivot-toolbar-summary {
        color: #8b949e;
        font-size: .82rem;
        margin-top: .15rem;
    }

    .type-pivot-collapse-body {
        border-top: 1px solid #30363d;
        margin-top: .75rem;
        padding-top: .75rem;
    }

    .type-pivot-plot-grid {
        display: grid;
        grid-template-columns: minmax(180px, 240px) minmax(280px, 1fr) auto;
        gap: .75rem;
        align-items: start;
    }

    .type-pivot-plot-y-select {
        min-height: 7rem;
    }

    .type-pivot-plot-action {
        align-self: end;
    }

    .type-pivot-plot-status {
        color: #8b949e;
        font-size: .84rem;
        margin-bottom: .75rem;
    }

    .type-pivot-plot-status.is-error {
        color: #f85149;
    }

    .type-pivot-plot-host {
        min-height: 560px;
        width: 100%;
    }

    .type-pivot-plot-modal .modal-dialog {
        max-width: min(1320px, calc(100vw - 2rem));
    }

    .type-pivot-plot-modal .modal-content {
        background: #161b22;
        border: 1px solid #30363d;
        color: #c9d1d9;
    }

    .type-pivot-plot-modal .modal-header {
        border-bottom: 1px solid #30363d;
    }

    .type-pivot-plot-modal .modal-body {
        padding: 1rem;
    }
</style>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h4 style="margin:0;color:#c9d1d9;font-weight:600;">Vista orizzontale per tipo report: @Model.ReportTypeKey</h4>
    <div style="color:#8b949e;font-size:.85rem;">File totali: @Model.TotalFiles</div>
</div>

<div class="rrda-card mb-2">
    <div class="type-pivot-toolbar">
        <div>
            <p class="type-pivot-toolbar-title">Filtri dati</p>
            <div class="type-pivot-toolbar-summary">Batch, data modifica, campo misura e @Model.SubjectKeyLabel</div>
        </div>
        <button class="btn-rrda-primary" type="button" data-bs-toggle="collapse" data-bs-target="#typePivotFilters" aria-expanded="false" aria-controls="typePivotFilters">
            Filtri
        </button>
    </div>
    <div class="collapse" id="typePivotFilters">
        <div class="type-pivot-collapse-body">
            <form method="get" class="row g-2 align-items-end">
                <input type="hidden" name="reportTypeId" value="@Model.ReportTypeId" />

                <div class="col-md-3">
                    <label class="form-label">Batch</label>
                    <select class="form-select" name="batchId">
                        <option value="">Tutti</option>
                        @foreach (var batch in Model.BatchOptions)
                        {
                            <option value="@batch.Id" selected="@(Model.BatchId == batch.Id)">@batch.Label</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Ultima modifica da</label>
                    <input type="date" class="form-control" name="lastModifiedFrom" value="@(Model.LastModifiedFrom?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Ultima modifica a</label>
                    <input type="date" class="form-control" name="lastModifiedTo" value="@(Model.LastModifiedTo?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Campo filtro</label>
                    <select class="form-select" name="filterField">
                        <option value="">--</option>
                        @foreach (var f in Model.DynamicFilterFields)
                        {
                            <option value="@f" selected="@(Model.FilterField == f)">@f</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Campo da</label>
                    <input class="form-control" name="filterFrom" value="@Model.FilterFrom" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Campo a</label>
                    <input class="form-control" name="filterTo" value="@Model.FilterTo" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">@Model.SubjectKeyLabel da</label>
                    <input class="form-control" name="subjectKeyFrom" value="@Model.SubjectKeyFrom" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">@Model.SubjectKeyLabel a</label>
                    <input class="form-control" name="subjectKeyTo" value="@Model.SubjectKeyTo" />
                </div>

                <div class="col-md-1">
                    <button class="btn-rrda-primary" type="submit">Applica</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="rrda-card mb-2">
    <div class="type-pivot-toolbar">
        <div>
            <p class="type-pivot-toolbar-title">Parametri grafico</p>
            <div class="type-pivot-toolbar-summary">Asse X, colonne asse Y e righe selezionate dalla tabella</div>
        </div>
        <button class="btn-rrda-primary" type="button" data-bs-toggle="collapse" data-bs-target="#typePivotPlotParameters" aria-expanded="false" aria-controls="typePivotPlotParameters">
            Grafico
        </button>
    </div>
    <div class="collapse" id="typePivotPlotParameters">
        <div class="type-pivot-collapse-body">
            <form id="plot-data-form"
                  asp-area="Data"
                  asp-controller="Tabular"
                  asp-action="TypePivotPlotData"
                  method="get"
                  class="type-pivot-plot-grid">
                <input type="hidden" name="reportTypeId" value="@Model.ReportTypeId" />
                <input type="hidden" name="batchId" value="@Model.BatchId" />
                <input type="hidden" name="lastModifiedFrom" value="@(Model.LastModifiedFrom?.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="lastModifiedTo" value="@(Model.LastModifiedTo?.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="filterField" value="@Model.FilterField" />
                <input type="hidden" name="filterFrom" value="@Model.FilterFrom" />
                <input type="hidden" name="filterTo" value="@Model.FilterTo" />
                <input type="hidden" name="subjectKeyFrom" value="@Model.SubjectKeyFrom" />
                <input type="hidden" name="subjectKeyTo" value="@Model.SubjectKeyTo" />

                <div>
                    <label class="form-label">Asse X</label>
                    <select class="form-select" name="xField">
                        @foreach (var field in Model.PlotXAxisFields)
                        {
                            var fieldLabel = field == "SubjectKey" ? Model.SubjectKeyLabel : field;
                            <option value="@field">@fieldLabel</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label">Colonne asse Y</label>
                    <select class="form-select type-pivot-plot-y-select" name="yFields" multiple size="5">
                        @foreach (var field in Model.PlotYAxisFields)
                        {
                            var label = field;
                            if (Model.HeaderUnits.TryGetValue(field, out var unit)
                                && !string.IsNullOrWhiteSpace(unit))
                            {
                                label = $"{field} [{unit}]";
                            }

                            <option value="@field">@label</option>
                        }
                    </select>
                </div>

                <div class="type-pivot-plot-action">
                    <button class="btn-rrda-primary" type="submit">Genera scatter</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="rrda-card mt-3" style="overflow:auto;">
    @if (!Model.Rows.Any())
    {
        <p style="color:#8b949e;margin:0;">Nessun file disponibile per questo report type.</p>
    }
    else
    {
        <table class="table table-borderless mb-0 type-pivot-table" style="min-width:1400px;">
            <thead>
                <tr>
                    <th style="font-size:.78rem;white-space:nowrap;">
                        <input class="form-check-input" type="checkbox" id="plot-select-all" title="Seleziona tutte le righe della pagina" />
                    </th>
                    @* ── SubjectKey: prima colonna, header semplice senza popup ── *@
                    @if (Model.HasSubjectKey)
                    {
                        <th style="font-family:monospace;font-size:.78rem;white-space:nowrap;">
                            <div class="dropdown">
                                <button class="btn btn-sm dropdown-toggle type-pivot-header-btn" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                    @Model.SubjectKeyLabel
                                    <span class="sort-indicator sort-asc"></span>
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            Ordinamento crescente ▲
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#">
                                            Ordinamento decrescente ▼
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </th>
                    }
                    @* ── Colonne statiche file ── *@
                    <th>Batch</th>
                    <th>Nome file</th>
                    <th>Ultima modifica</th>
                    @* ── Colonne di misura con popup statistico ── *@
                    @foreach (var header in Model.Headers)
                    {
                        var headerLabel = header;
                        if (Model.HeaderUnits.TryGetValue(header, out var unit)
                            && !string.IsNullOrWhiteSpace(unit))
                        {
                            headerLabel = $"{header} [{unit}]";
                        }

                        <th style="font-family:monospace;font-size:.78rem;">
                            <div class="dropdown">
                                <button class="btn btn-sm dropdown-toggle type-pivot-header-btn" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false">@headerLabel</button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Data"
                                           asp-controller="Statistics"
                                           asp-action="Distribution"
                                           asp-route-reportTypeId="@Model.ReportTypeId"
                                           asp-route-field="@header"
                                           asp-route-batchId="@Model.BatchId"
                                           asp-route-uploadedFrom="@(Model.LastModifiedFrom?.ToString("yyyy-MM-dd"))"
                                           asp-route-uploadedTo="@(Model.LastModifiedTo?.ToString("yyyy-MM-dd"))">
                                            Distribuzione
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#"
                                           onclick="alert('Diagramma di dispersione: vista in implementazione'); return false;">
                                            Diagramma di dispersione
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>
                            <input class="form-check-input plot-row-selector"
                                   type="checkbox"
                                   name="selectedFileIds"
                                   value="@row.FileId"
                                   form="plot-data-form"
                                   title="Usa questa riga nel JSON grafico" />
                        </td>
                        @* ── SubjectKey: renderizzato come intero (o stringa se non numerico) ── *@
                        @if (Model.HasSubjectKey)
                        {
                            <td style="font-family:monospace;font-size:.78rem;white-space:nowrap;">
                                @{
                                    var skRaw = row.SubjectKey;
                                    if (!string.IsNullOrWhiteSpace(skRaw)
                                        && long.TryParse(skRaw, NumberStyles.Any, CultureInfo.InvariantCulture, out var skLong))
                                    {
                                        @skLong
                                    }
                                    else if (!string.IsNullOrWhiteSpace(skRaw)
                                             && double.TryParse(skRaw, NumberStyles.Any, CultureInfo.InvariantCulture, out var skDouble))
                                    {
                                        @((long)Math.Round(skDouble))
                                    }
                                    else
                                    {
                                        @(skRaw ?? "")
                                    }
                                }
                            </td>
                        }
                        @* ── Colonne statiche ── *@

                        <td style="font-size:.78rem;">@(row.BatchName ?? "—")</td>
                        <td style="font-family:monospace;font-size:.78rem;">@row.FileName</td>
                        <td style="font-size:.78rem;">@row.LastModified.ToString("yyyy-MM-dd HH:mm")</td>
                        @* ── Valori di misura: double con decimali configurati ── *@
                        @foreach (var header in Model.Headers)
                        {
                            <td style="font-family:monospace;font-size:.78rem;white-space:nowrap;">
                                @{
                                    if (row.Values.TryGetValue(header, out var value))
                                    {
                                        if (double.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out var dInv))
                                        {
                                            @Math.Round(dInv, Model.DecimalPlaces).ToString($"F{Model.DecimalPlaces}", CultureInfo.InvariantCulture)
                                        }
                                        else if (double.TryParse(value, NumberStyles.Any, CultureInfo.CurrentCulture, out var dCur))
                                        {
                                            @Math.Round(dCur, Model.DecimalPlaces).ToString($"F{Model.DecimalPlaces}", CultureInfo.CurrentCulture)
                                        }
                                        else
                                        {
                                            @(value ?? "")
                                        }
                                    }
                                }
                            </td>
                        }
                    
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="@staticFooterColumns" style="font-size:.76rem;color:#8b949e;">Max</th>
                    @foreach (var header in Model.Headers)
                    {
                        Model.ColumnStatistics.TryGetValue(header, out var stats);
                        <td style="font-family:monospace;font-size:.76rem;white-space:nowrap;color:#c9d1d9;">
                            @FormatStatistic(stats?.Max)
                        </td>
                    }
                </tr>
                <tr>
                    <th colspan="@staticFooterColumns" style="font-size:.76rem;color:#8b949e;">Media</th>
                    @foreach (var header in Model.Headers)
                    {
                        Model.ColumnStatistics.TryGetValue(header, out var stats);
                        <td style="font-family:monospace;font-size:.76rem;white-space:nowrap;color:#c9d1d9;">
                            @FormatStatistic(stats?.Mean)
                        </td>
                    }
                </tr>
                <tr>
                    <th colspan="@staticFooterColumns" style="font-size:.76rem;color:#8b949e;">Min</th>
                    @foreach (var header in Model.Headers)
                    {
                        Model.ColumnStatistics.TryGetValue(header, out var stats);
                        <td style="font-family:monospace;font-size:.76rem;white-space:nowrap;color:#c9d1d9;">
                            @FormatStatistic(stats?.Min)
                        </td>
                    }
                </tr>
@*                 <tr>
                    <th colspan="@staticFooterColumns" style="font-size:.76rem;color:#8b949e;">Mediana</th>
                    @foreach (var header in Model.Headers)
                    {
                        Model.ColumnStatistics.TryGetValue(header, out var stats);
                        <td style="font-family:monospace;font-size:.76rem;white-space:nowrap;color:#c9d1d9;">
                            @FormatStatistic(stats?.Median)
                        </td>
                    }
                </tr> *@
                <tr>
                    <th colspan="@staticFooterColumns" style="font-size:.76rem;color:#8b949e;">Dev. std</th>
                    @foreach (var header in Model.Headers)
                    {
                        Model.ColumnStatistics.TryGetValue(header, out var stats);
                        <td style="font-family:monospace;font-size:.76rem;white-space:nowrap;color:#c9d1d9;">
                            @FormatStatistic(stats?.StandardDeviation)
                        </td>
                    }
                </tr>
            </tfoot>
        </table>
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="d-flex gap-2 mt-3">
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <a asp-action="TypePivot"
               asp-route-reportTypeId="@Model.ReportTypeId"
               asp-route-page="@p"
               asp-route-pageSize="@Model.PageSize"
               asp-route-batchId="@Model.BatchId"
               asp-route-lastModifiedFrom="@(Model.LastModifiedFrom?.ToString("yyyy-MM-dd"))"
               asp-route-lastModifiedTo="@(Model.LastModifiedTo?.ToString("yyyy-MM-dd"))"
               asp-route-filterField="@Model.FilterField"
               asp-route-filterFrom="@Model.FilterFrom"
               asp-route-filterTo="@Model.FilterTo"
               asp-route-subjectKeyFrom="@Model.SubjectKeyFrom"
               asp-route-subjectKeyTo="@Model.SubjectKeyTo"
               style="padding:.2rem .55rem;border:1px solid #30363d;border-radius:5px; text-decoration:none;color:
                    @(p == Model.CurrentPage ? "#58a6ff" : "#8b949e");">@p
            </a>
        }
    </div>
}

<div class="modal fade type-pivot-plot-modal" id="typePivotPlotModal" tabindex="-1" aria-labelledby="typePivotPlotModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="typePivotPlotModalTitle">Scatter</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body">
                <div id="typePivotPlotStatus" class="type-pivot-plot-status"></div>
                <div id="typePivotPlot" class="type-pivot-plot-host"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/plotly/plotly.min.js"></script>
    <script>
        (() => {
            const selectAll = document.getElementById('plot-select-all');
            if (selectAll) {
                selectAll.addEventListener('change', () => {
                    document.querySelectorAll('.plot-row-selector')
                        .forEach(checkbox => checkbox.checked = selectAll.checked);
                });
            }

            const form = document.getElementById('plot-data-form');
            const plotModalElement = document.getElementById('typePivotPlotModal');
            const plotHost = document.getElementById('typePivotPlot');
            const plotStatus = document.getElementById('typePivotPlotStatus');
            const plotModal = plotModalElement ? new bootstrap.Modal(plotModalElement) : null;

            if (!form || !plotModalElement || !plotModal || !plotHost || !plotStatus) {
                return;
            }

            const setStatus = (message, isError = false) => {
                plotStatus.textContent = message;
                plotStatus.classList.toggle('is-error', isError);
            };

            const getAxisTitleText = axis => {
                if (!axis || !axis.title) {
                    return '';
                }

                return typeof axis.title === 'string'
                    ? axis.title
                    : axis.title.text || '';
            };

            form.addEventListener('submit', async event => {
                event.preventDefault();
                plotModal.show();

                if (!window.Plotly) {
                    setStatus('Plotly.js non e disponibile. Installare wwwroot/lib/plotly/plotly.min.js.', true);
                    return;
                }

                const selectedYFields = form.querySelectorAll('select[name="yFields"] option:checked');
                if (selectedYFields.length === 0) {
                    setStatus('Selezionare almeno una colonna per asse Y.', true);
                    plotHost.innerHTML = '';
                    return;
                }

                setStatus('Generazione scatter in corso...');

                try {
                    const response = await fetch(`${form.action}?${new URLSearchParams(new FormData(form))}`, {
                        headers: { 'Accept': 'application/json' }
                    });

                    const payload = await response.json();
                    if (!response.ok) {
                        throw new Error(payload.message || 'Errore durante la generazione del grafico.');
                    }

                    const layout = {
                        ...payload.layout,
                        paper_bgcolor: '#ffffff',
                        plot_bgcolor: '#ffffff',
                        font: { color: '#24292f' },
                        margin: { l: 96, r: 32, t: 64, b: 96 },
                        xaxis: {
                            ...payload.layout.xaxis,
                            automargin: true,
                            linecolor: '#57606a',
                            gridcolor: '#d8dee4',
                            zerolinecolor: '#d0d7de',
                            tickfont: { color: '#24292f' },
                            title: {
                                text: getAxisTitleText(payload.layout.xaxis),
                                font: { color: '#24292f', size: 14 },
                                standoff: 22
                            }
                        },
                        yaxis: {
                            ...payload.layout.yaxis,
                            automargin: true,
                            linecolor: '#57606a',
                            gridcolor: '#d8dee4',
                            zerolinecolor: '#d0d7de',
                            tickfont: { color: '#24292f' },
                            title: {
                                text: getAxisTitleText(payload.layout.yaxis),
                                font: { color: '#24292f', size: 14 },
                                standoff: 28
                            }
                        },
                        legend: {
                            orientation: 'h',
                            y: -0.2,
                            font: { color: '#24292f' }
                        }
                    };

                    await Plotly.react(plotHost, payload.traces, layout, {
                        responsive: true,
                        displaylogo: false
                    });
                    Plotly.Plots.resize(plotHost);
                    setStatus(`Scatter generato su ${payload.rowCount} righe filtrate.`);
                } catch (error) {
                    plotHost.innerHTML = '';
                    setStatus(error.message || 'Errore durante la generazione del grafico.', true);
                }
            });

            plotModalElement.addEventListener('shown.bs.modal', () => {
                if (window.Plotly) {
                    Plotly.Plots.resize(plotHost);
                }
            });
        })();
    </script>
}
