@using System.Globalization
@model RRDA.Web.Areas.Data.Controllers.TypePivotViewModel
@{
    ViewData["Title"] = $"Type Pivot - {Model.ReportTypeKey}";
    var staticFooterColumns = Model.HasSubjectKey ? 5 : 4;

    string FormatStatistic(double? value)
    {
        return value.HasValue
            ? Math.Round(value.Value, Model.DecimalPlaces).ToString($"F{Model.DecimalPlaces}", CultureInfo.InvariantCulture)
            : "";
    }
}

<style>
    .type-pivot-table td, .type-pivot-table th {
        padding: .25rem .5rem;
    }

    .type-pivot-filter-card {
        position: sticky;
        top: calc(var(--topbar-height) + .75rem);
        z-index: 1010;
    }

    .type-pivot-table-scroll {
        max-height: calc(100vh - 1rem);
        overflow: auto;
        padding: 0;
        position: relative;
        scrollbar-color: #484f58 #161b22;
        scrollbar-width: thin;
    }

    .type-pivot-table-scroll::-webkit-scrollbar {
        height: 11px;
        width: 11px;
    }

    .type-pivot-table-scroll::-webkit-scrollbar-track {
        background: #161b22;
    }

    .type-pivot-table-scroll::-webkit-scrollbar-thumb {
        background: #484f58;
        border: 2px solid #161b22;
        border-radius: 8px;
    }

    .type-pivot-table-scroll::-webkit-scrollbar-thumb:hover {
        background: #6e7681;
    }

    .type-pivot-table-scroll::-webkit-scrollbar-corner {
        background: #161b22;
    }

    .type-pivot-table {
        border-collapse: separate;
        border-spacing: 0;
    }

    .type-pivot-table thead {
        position: sticky;
        top: 0;
        z-index: 5;
    }

    .type-pivot-table thead th {
        background: #0d1117;
        box-shadow: inset 0 -1px #30363d;
    }

    .type-pivot-sort-link {
        align-items: center;
        color: #c9d1d9;
        display: inline-flex;
        gap: .35rem;
        text-decoration: none;
    }

    .type-pivot-sort-link:hover,
    .type-pivot-sort-link:focus {
        color: #58a6ff;
    }

    .type-pivot-sort-indicator {
        color: #58a6ff;
        font-size: .7rem;
    }

    .type-pivot-table tfoot {
        bottom: 0;
        position: sticky;
        z-index: 4;
    }

    .type-pivot-table tfoot th,
    .type-pivot-table tfoot td {
        background: #161b22;
    }

    .type-pivot-table tfoot tr:first-child > * {
        box-shadow: inset 0 1px #30363d;
    }

    /* Zebra stripe styling for improved readability */
    .type-pivot-table tbody tr:nth-child(odd) {
        background-color: #0d1117;
    }

    .type-pivot-table tbody tr:nth-child(even) {
        background-color: #1c2128;
    }

    .type-pivot-table tbody tr:hover {
        background-color: #262c36;
    }

    .type-pivot-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
    }

    .type-pivot-compact-card {
        padding: .75rem 1rem;
    }

    .type-pivot-toolbar-actions,
    .type-pivot-form-actions {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
    }

    .type-pivot-action-link {
        border-radius: 6px;
        padding: .4rem .75rem;
        text-decoration: none;
    }

    .type-pivot-toolbar-title {
        color: #c9d1d9;
        font-weight: 600;
        margin: 0;
    }

    .type-pivot-toolbar-summary {
        color: #8b949e;
        font-size: .82rem;
        margin-top: .15rem;
    }

    .type-pivot-collapse-toggle {
        align-items: center;
        background: transparent;
        border: 1px solid #30363d;
        border-radius: 50%;
        display: inline-flex;
        height: 2rem;
        justify-content: center;
        padding: 0;
        width: 2rem;
    }

    .type-pivot-collapse-toggle::after {
        border-bottom: 2px solid #8b949e;
        border-right: 2px solid #8b949e;
        content: "";
        height: .55rem;
        margin-top: -.25rem;
        transform: rotate(45deg);
        transition: transform .2s ease, margin-top .2s ease;
        width: .55rem;
    }

    .type-pivot-collapse-toggle[aria-expanded="true"]::after {
        margin-top: .25rem;
        transform: rotate(225deg);
    }

    .type-pivot-collapse-toggle:hover,
    .type-pivot-collapse-toggle:focus {
        border-color: #58a6ff;
        box-shadow: none;
    }

    .type-pivot-collapse-toggle:hover::after,
    .type-pivot-collapse-toggle:focus::after {
        border-color: #58a6ff;
    }

    .type-pivot-collapse-body {
        border-top: 1px solid #30363d;
        margin-top: .5rem;
        padding-top: .5rem;
    }

    .type-pivot-plot-grid {
        display: grid;
        grid-template-columns: minmax(160px, 220px) minmax(180px, 240px) minmax(280px, 1fr) auto;
        gap: .5rem;
        align-items: start;
    }

    .type-pivot-plot-y-select {
        min-height: 5.5rem;
    }

    .type-pivot-plot-action {
        align-self: start;
        padding-top: calc(1.275rem + .3rem);
    }

    .type-pivot-plot-action .type-pivot-form-actions {
        flex-wrap: nowrap;
    }

    .type-pivot-plot-status {
        color: #8b949e;
        font-size: .84rem;
        margin-bottom: .75rem;
    }

    .type-pivot-plot-status.is-error {
        color: #f85149;
    }

    .type-pivot-plot-frame {
        position: relative;
        min-height: 560px;
    }

    .type-pivot-plot-host {
        min-height: 560px;
        width: 100%;
    }

    .type-pivot-plot-frame.is-loading .type-pivot-plot-host {
        visibility: hidden;
    }

    .type-pivot-plot-loading-overlay {
        align-items: center;
        background: #0d1117e6;
        color: #c9d1d9;
        display: none;
        flex-direction: column;
        gap: .75rem;
        inset: 0;
        justify-content: center;
        position: absolute;
        text-align: center;
        z-index: 2;
    }

    .type-pivot-plot-frame.is-loading .type-pivot-plot-loading-overlay {
        display: flex;
    }

    .type-pivot-plot-loading-overlay p {
        color: #8b949e;
        font-size: .875rem;
        margin: 0;
    }

    .type-pivot-plot-modal .modal-dialog {
        max-width: min(1320px, calc(100vw - 2rem));
    }

    .type-pivot-plot-modal .modal-content {
        background: #161b22;
        border: 1px solid #30363d;
        color: #c9d1d9;
    }

    .type-pivot-plot-modal .modal-header {
        border-bottom: 1px solid #30363d;
    }

    .type-pivot-plot-modal .modal-body {
        padding: 1rem;
    }
</style>

<div class="d-flex align-items-center justify-content-between mb-3">
    <h4 style="margin:0;color:#c9d1d9;font-weight:600;">Vista orizzontale per tipo report: @Model.ReportTypeKey</h4>
    <div class="type-pivot-toolbar-actions">
        <span style="color:#8b949e;font-size:.85rem;">File filtrati: @Model.TotalFiles</span>
        <a asp-area="Data"
           asp-controller="Tabular"
           asp-action="TypePivotExport"
           asp-route-reportTypeId="@Model.ReportTypeId"
           asp-route-batchId="@Model.BatchId"
           asp-route-lastModifiedFrom="@(Model.LastModifiedFrom?.ToString("yyyy-MM-dd"))"
           asp-route-lastModifiedTo="@(Model.LastModifiedTo?.ToString("yyyy-MM-dd"))"
           asp-route-filterField="@Model.FilterField"
           asp-route-filterFrom="@Model.FilterFrom"
           asp-route-filterTo="@Model.FilterTo"
           asp-route-subjectKeyFrom="@Model.SubjectKeyFrom"
           asp-route-subjectKeyTo="@Model.SubjectKeyTo"
           asp-route-format="csv"
           class="btn-rrda-primary type-pivot-action-link">Esporta CSV</a>
        <a asp-area="Data"
           asp-controller="Tabular"
           asp-action="TypePivotExport"
           asp-route-reportTypeId="@Model.ReportTypeId"
           asp-route-batchId="@Model.BatchId"
           asp-route-lastModifiedFrom="@(Model.LastModifiedFrom?.ToString("yyyy-MM-dd"))"
           asp-route-lastModifiedTo="@(Model.LastModifiedTo?.ToString("yyyy-MM-dd"))"
           asp-route-filterField="@Model.FilterField"
           asp-route-filterFrom="@Model.FilterFrom"
           asp-route-filterTo="@Model.FilterTo"
           asp-route-subjectKeyFrom="@Model.SubjectKeyFrom"
           asp-route-subjectKeyTo="@Model.SubjectKeyTo"
           asp-route-format="excel"
           class="btn-rrda-primary type-pivot-action-link">Esporta Excel</a>
    </div>
</div>

<div class="rrda-card mb-2 type-pivot-filter-card type-pivot-compact-card">
    <div class="type-pivot-toolbar">
        <div>
            <p class="type-pivot-toolbar-title">Filtri dati</p>
            <div class="type-pivot-toolbar-summary">Batch, data modifica, campo misura e @Model.SubjectKeyLabel</div>
        </div>
        <button class="type-pivot-collapse-toggle"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#typePivotFilters"
                aria-expanded="false"
                aria-controls="typePivotFilters"
                aria-label="Espandi o comprimi filtri"></button>
    </div>
    <div class="collapse" id="typePivotFilters">
        <div class="type-pivot-collapse-body">
            <form id="type-pivot-filter-form" method="get" class="row g-2 align-items-end">
                <input type="hidden" name="reportTypeId" value="@Model.ReportTypeId" />
                <input type="hidden" name="sortField" value="@Model.SortField" />
                <input type="hidden" name="sortDirection" value="@Model.SortDirection" />

                <div class="col-md-3">
                    <label class="form-label">Batch</label>
                    <select class="form-select" name="batchId">
                        <option value="">Tutti</option>
                        @foreach (var batch in Model.BatchOptions)
                        {
                            <option value="@batch.Id" selected="@(Model.BatchId == batch.Id)">@batch.Label</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Ultima modifica da</label>
                    <input type="date" class="form-control" name="lastModifiedFrom" value="@(Model.LastModifiedFrom?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Ultima modifica a</label>
                    <input type="date" class="form-control" name="lastModifiedTo" value="@(Model.LastModifiedTo?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Campo filtro</label>
                    <select class="form-select" name="filterField">
                        <option value="">--</option>
                        @foreach (var f in Model.DynamicFilterFields)
                        {
                            <option value="@f" selected="@(Model.FilterField == f)">@f</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Campo da</label>
                    <input class="form-control" name="filterFrom" value="@Model.FilterFrom" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Campo a</label>
                    <input class="form-control" name="filterTo" value="@Model.FilterTo" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">@Model.SubjectKeyLabel da</label>
                    <input class="form-control" name="subjectKeyFrom" value="@Model.SubjectKeyFrom" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">@Model.SubjectKeyLabel a</label>
                    <input class="form-control" name="subjectKeyTo" value="@Model.SubjectKeyTo" />
                </div>

                <div class="col-md-auto type-pivot-form-actions">
                    <button class="btn-rrda-primary" type="submit">Applica</button>
                    <a asp-action="TypePivot"
                       asp-route-reportTypeId="@Model.ReportTypeId"
                       class="btn-rrda-danger type-pivot-action-link">Azzera filtri</a>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="rrda-card mb-2 type-pivot-compact-card">
    <div class="type-pivot-toolbar">
        <div>
            <p class="type-pivot-toolbar-title">Parametri grafico</p>
            <div class="type-pivot-toolbar-summary">Tipo grafico, assi, colonne e righe selezionate dalla tabella</div>
        </div>
        <button class="type-pivot-collapse-toggle"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#typePivotPlotParameters"
                aria-expanded="false"
                aria-controls="typePivotPlotParameters"
                aria-label="Espandi o comprimi parametri grafico"></button>
    </div>
    <div class="collapse" id="typePivotPlotParameters">
        <div class="type-pivot-collapse-body">
            <form id="plot-data-form"
                  asp-area="Data"
                  asp-controller="Tabular"
                  asp-action="TypePivotPlotData"
                  method="get"
                  class="type-pivot-plot-grid">
                <input type="hidden" name="reportTypeId" value="@Model.ReportTypeId" />
                <input type="hidden" name="batchId" value="@Model.BatchId" />
                <input type="hidden" name="lastModifiedFrom" value="@(Model.LastModifiedFrom?.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="lastModifiedTo" value="@(Model.LastModifiedTo?.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="filterField" value="@Model.FilterField" />
                <input type="hidden" name="filterFrom" value="@Model.FilterFrom" />
                <input type="hidden" name="filterTo" value="@Model.FilterTo" />
                <input type="hidden" name="subjectKeyFrom" value="@Model.SubjectKeyFrom" />
                <input type="hidden" name="subjectKeyTo" value="@Model.SubjectKeyTo" />

                <div>
                    <label class="form-label">Tipo grafico</label>
                    <select class="form-select" name="chartType">
                        <option value="scatter">Scatter</option>
                        <option value="pdf">PDF</option>
                    </select>
                </div>

                <div>
                    <label class="form-label" id="plot-x-field-label" for="plot-x-field">Asse X</label>
                    <select class="form-select" id="plot-x-field" name="xField">
                        @foreach (var field in Model.PlotXAxisFields)
                        {
                            var fieldLabel = field == "SubjectKey" ? Model.SubjectKeyLabel : field;
                            <option value="@field">@fieldLabel</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="form-label" id="plot-series-fields-label" for="plot-series-fields">Colonne asse Y</label>
                    <select class="form-select type-pivot-plot-y-select" id="plot-series-fields" name="seriesFields" multiple size="5">
                        @foreach (var field in Model.PlotYAxisFields)
                        {
                            var label = field;
                            if (Model.HeaderUnits.TryGetValue(field, out var unit)
                                && !string.IsNullOrWhiteSpace(unit))
                            {
                                label = $"{field} [{unit}]";
                            }

                            <option value="@field">@label</option>
                        }
                    </select>
                </div>

                <div class="type-pivot-plot-action">
                    <div class="type-pivot-form-actions">
                        <button class="btn-rrda-primary" type="submit">Genera grafico</button>
                        <button class="btn-rrda-danger" id="reset-plot-button" type="button">Reset grafico</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="typePivotFilterLoadingModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="typePivotFilterLoadingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background:#161b22;border:1px solid #30363d;color:#c9d1d9;">
            <div class="modal-body" style="padding:1.5rem;">
                <div class="d-flex align-items-center gap-3">
                    <div class="spinner-border text-primary rrda-loading-spinner" role="status" aria-hidden="true"></div>
                    <div>
                        <h6 id="typePivotFilterLoadingModalLabel" style="margin:0 0 .35rem 0;color:#c9d1d9;font-weight:600;">Applicazione filtri</h6>
                        <p style="margin:0;color:#8b949e;font-size:.875rem;">
                            Elaborazione dei dati in corso. L'operazione puo richiedere qualche istante in base al volume dei record.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="rrda-card mt-3 type-pivot-table-scroll">
    @if (!Model.Rows.Any())
    {
        <p style="color:#8b949e;margin:0;">Nessun file disponibile per questo report type.</p>
    }
    else
    {
        <table class="table table-borderless mb-0 type-pivot-table" style="min-width:1400px;">
            <thead>
                <tr>
                    <th style="font-size:.78rem;white-space:nowrap;">
                        <input class="form-check-input" type="checkbox" id="plot-select-all" title="Seleziona tutte le righe della pagina" />
                    </th>
                    @* ── SubjectKey: prima colonna ── *@
                    @if (Model.HasSubjectKey)
                    {
                        <th style="font-family:monospace;font-size:.78rem;white-space:nowrap;">
                            <a class="type-pivot-sort-link"
                               asp-action="TypePivot"
                               asp-route-reportTypeId="@Model.ReportTypeId"
                               asp-route-page="1"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-batchId="@Model.BatchId"
                               asp-route-lastModifiedFrom="@(Model.LastModifiedFrom?.ToString("yyyy-MM-dd"))"
                               asp-route-lastModifiedTo="@(Model.LastModifiedTo?.ToString("yyyy-MM-dd"))"
                               asp-route-filterField="@Model.FilterField"
                               asp-route-filterFrom="@Model.FilterFrom"
                               asp-route-filterTo="@Model.FilterTo"
                               asp-route-subjectKeyFrom="@Model.SubjectKeyFrom"
                               asp-route-subjectKeyTo="@Model.SubjectKeyTo"
                               asp-route-sortField="SubjectKey"
                               asp-route-sortDirection="@(Model.SortField == "SubjectKey" && Model.SortDirection == "asc" ? "desc" : "asc")">
                                @Model.SubjectKeyLabel
                                <span class="type-pivot-sort-indicator">
                                    @(Model.SortField == "SubjectKey" ? (Model.SortDirection == "desc" ? "▼" : "▲") : "⇅")
                                </span>
                            </a>
                        </th>
                    }
                    @* ── Colonne statiche file ── *@
                    <th>Batch</th>
                    <th>Nome file</th>
                    <th>Ultima modifica</th>
                    @* ── Colonne di misura ── *@
                    @foreach (var header in Model.Headers)
                    {
                        var headerLabel = header;
                        if (Model.HeaderUnits.TryGetValue(header, out var unit)
                            && !string.IsNullOrWhiteSpace(unit))
                        {
                            headerLabel = $"{header} [{unit}]";
                        }

                        <th style="font-family:monospace;font-size:.78rem;white-space:nowrap;">
                            @headerLabel
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>
                            <input class="form-check-input plot-row-selector"
                                   type="checkbox"
                                   name="selectedFileIds"
                                   value="@row.FileId"
                                   form="plot-data-form"
                                   title="Usa questa riga nel JSON grafico" />
                        </td>
                        @* ── SubjectKey: renderizzato come intero (o stringa se non numerico) ── *@
                        @if (Model.HasSubjectKey)
                        {
                            <td style="font-family:monospace;font-size:.78rem;white-space:nowrap;">
                                @{
                                    var skRaw = row.SubjectKey;
                                    if (!string.IsNullOrWhiteSpace(skRaw)
                                        && long.TryParse(skRaw, NumberStyles.Any, CultureInfo.InvariantCulture, out var skLong))
                                    {
                                        @skLong
                                    }
                                    else if (!string.IsNullOrWhiteSpace(skRaw)
                                             && double.TryParse(skRaw, NumberStyles.Any, CultureInfo.InvariantCulture, out var skDouble))
                                    {
                                        @((long)Math.Round(skDouble))
                                    }
                                    else
                                    {
                                        @(skRaw ?? "")
                                    }
                                }
                            </td>
                        }
                        @* ── Colonne statiche ── *@

                        <td style="font-size:.78rem;">@(row.BatchName ?? "—")</td>
                        <td style="font-family:monospace;font-size:.78rem;">@row.FileName</td>
                        <td style="font-size:.78rem;">@row.LastModified.ToString("yyyy-MM-dd HH:mm")</td>
                        @* ── Valori di misura: double con decimali configurati ── *@
                        @foreach (var header in Model.Headers)
                        {
                            <td style="font-family:monospace;font-size:.78rem;white-space:nowrap;">
                                @{
                                    if (row.Values.TryGetValue(header, out var value))
                                    {
                                        if (double.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out var dInv))
                                        {
                                            @Math.Round(dInv, Model.DecimalPlaces).ToString($"F{Model.DecimalPlaces}", CultureInfo.InvariantCulture)
                                        }
                                        else if (double.TryParse(value, NumberStyles.Any, CultureInfo.CurrentCulture, out var dCur))
                                        {
                                            @Math.Round(dCur, Model.DecimalPlaces).ToString($"F{Model.DecimalPlaces}", CultureInfo.CurrentCulture)
                                        }
                                        else
                                        {
                                            @(value ?? "")
                                        }
                                    }
                                }
                            </td>
                        }
                    
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="@staticFooterColumns" style="font-size:.76rem;color:#8b949e;">Max</th>
                    @foreach (var header in Model.Headers)
                    {
                        Model.ColumnStatistics.TryGetValue(header, out var stats);
                        <td style="font-family:monospace;font-size:.76rem;white-space:nowrap;color:#c9d1d9;">
                            @FormatStatistic(stats?.Max)
                        </td>
                    }
                </tr>
                <tr>
                    <th colspan="@staticFooterColumns" style="font-size:.76rem;color:#8b949e;">Media</th>
                    @foreach (var header in Model.Headers)
                    {
                        Model.ColumnStatistics.TryGetValue(header, out var stats);
                        <td style="font-family:monospace;font-size:.76rem;white-space:nowrap;color:#c9d1d9;">
                            @FormatStatistic(stats?.Mean)
                        </td>
                    }
                </tr>
                <tr>
                    <th colspan="@staticFooterColumns" style="font-size:.76rem;color:#8b949e;">Min</th>
                    @foreach (var header in Model.Headers)
                    {
                        Model.ColumnStatistics.TryGetValue(header, out var stats);
                        <td style="font-family:monospace;font-size:.76rem;white-space:nowrap;color:#c9d1d9;">
                            @FormatStatistic(stats?.Min)
                        </td>
                    }
                </tr>
@*                 <tr>
                    <th colspan="@staticFooterColumns" style="font-size:.76rem;color:#8b949e;">Mediana</th>
                    @foreach (var header in Model.Headers)
                    {
                        Model.ColumnStatistics.TryGetValue(header, out var stats);
                        <td style="font-family:monospace;font-size:.76rem;white-space:nowrap;color:#c9d1d9;">
                            @FormatStatistic(stats?.Median)
                        </td>
                    }
                </tr> *@
                <tr>
                    <th colspan="@staticFooterColumns" style="font-size:.76rem;color:#8b949e;">Dev. std</th>
                    @foreach (var header in Model.Headers)
                    {
                        Model.ColumnStatistics.TryGetValue(header, out var stats);
                        <td style="font-family:monospace;font-size:.76rem;white-space:nowrap;color:#c9d1d9;">
                            @FormatStatistic(stats?.StandardDeviation)
                        </td>
                    }
                </tr>
            </tfoot>
        </table>
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="d-flex gap-2 mt-3">
        @for (int p = 1; p <= Model.TotalPages; p++)
        {
            <a asp-action="TypePivot"
               asp-route-reportTypeId="@Model.ReportTypeId"
               asp-route-page="@p"
               asp-route-pageSize="@Model.PageSize"
               asp-route-batchId="@Model.BatchId"
               asp-route-lastModifiedFrom="@(Model.LastModifiedFrom?.ToString("yyyy-MM-dd"))"
               asp-route-lastModifiedTo="@(Model.LastModifiedTo?.ToString("yyyy-MM-dd"))"
               asp-route-filterField="@Model.FilterField"
               asp-route-filterFrom="@Model.FilterFrom"
               asp-route-filterTo="@Model.FilterTo"
               asp-route-subjectKeyFrom="@Model.SubjectKeyFrom"
               asp-route-subjectKeyTo="@Model.SubjectKeyTo"
               asp-route-sortField="@Model.SortField"
               asp-route-sortDirection="@Model.SortDirection"
               style="padding:.2rem .55rem;border:1px solid #30363d;border-radius:5px; text-decoration:none;color:
                    @(p == Model.CurrentPage ? "#58a6ff" : "#8b949e");">@p
            </a>
        }
    </div>
}

<div class="modal fade type-pivot-plot-modal" id="typePivotPlotModal" tabindex="-1" aria-labelledby="typePivotPlotModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="typePivotPlotModalTitle">Scatter</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body">
                <div id="typePivotPlotStatus" class="type-pivot-plot-status"></div>
                <div id="typePivotPlotFrame" class="type-pivot-plot-frame">
                    <div id="typePivotPlotLoadingOverlay" class="type-pivot-plot-loading-overlay" aria-live="polite" aria-atomic="true">
                        <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                        <p>Generazione del grafico in corso...</p>
                    </div>
                    <div id="typePivotPlot" class="type-pivot-plot-host"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/plotly/plotly.min.js"></script>
    <script>
        (() => {
            const filterForm = document.getElementById('type-pivot-filter-form');
            const filterLoadingModalElement = document.getElementById('typePivotFilterLoadingModal');
            const tableScroll = document.querySelector('.type-pivot-table-scroll');

            const resizeTableScroll = () => {
                if (!tableScroll) {
                    return;
                }

                const viewportBottomMargin = 16;
                const minimumTableHeight = 180;
                const availableHeight = window.innerHeight
                    - tableScroll.getBoundingClientRect().top
                    - viewportBottomMargin;

                tableScroll.style.maxHeight = `${Math.max(minimumTableHeight, availableHeight)}px`;
            };

            resizeTableScroll();
            window.addEventListener('resize', resizeTableScroll);
            document.querySelectorAll('#typePivotFilters, #typePivotPlotParameters')
                .forEach(panel => {
                    panel.addEventListener('shown.bs.collapse', resizeTableScroll);
                    panel.addEventListener('hidden.bs.collapse', resizeTableScroll);
                });

            if (filterForm && filterLoadingModalElement && window.bootstrap) {
                const filterLoadingModal = new bootstrap.Modal(filterLoadingModalElement, {
                    backdrop: 'static',
                    keyboard: false
                });

                filterForm.addEventListener('submit', event => {
                    if (event.defaultPrevented) {
                        return;
                    }

                    document.body.setAttribute('aria-busy', 'true');
                    filterForm.querySelectorAll('button[type="submit"]').forEach(button => {
                        button.setAttribute('aria-disabled', 'true');
                        button.style.pointerEvents = 'none';
                    });
                    filterLoadingModal.show();
                });
            }

            const selectAll = document.getElementById('plot-select-all');
            if (selectAll) {
                selectAll.addEventListener('change', () => {
                    document.querySelectorAll('.plot-row-selector')
                        .forEach(checkbox => checkbox.checked = selectAll.checked);
                });
            }

            const form = document.getElementById('plot-data-form');
            const plotModalElement = document.getElementById('typePivotPlotModal');
            const plotFrame = document.getElementById('typePivotPlotFrame');
            const plotHost = document.getElementById('typePivotPlot');
            const plotStatus = document.getElementById('typePivotPlotStatus');
            const plotModalTitle = document.getElementById('typePivotPlotModalTitle');
            const resetPlotButton = document.getElementById('reset-plot-button');
            const chartTypeSelect = form?.querySelector('select[name="chartType"]');
            const xFieldSelect = document.getElementById('plot-x-field');
            const xFieldLabel = document.getElementById('plot-x-field-label');
            const seriesFieldsLabel = document.getElementById('plot-series-fields-label');
            const plotModal = plotModalElement ? new bootstrap.Modal(plotModalElement) : null;
            let plotRequestSequence = 0;
            let activePlotRequest = null;
            let scatterXField = xFieldSelect?.value;

            if (!form || !plotModalElement || !plotModal || !plotFrame || !plotHost || !plotStatus
                || !plotModalTitle || !chartTypeSelect || !xFieldSelect || !xFieldLabel || !seriesFieldsLabel) {
                return;
            }

            const setStatus = (message, isError = false) => {
                plotStatus.textContent = message;
                plotStatus.classList.toggle('is-error', isError);
            };

            const clearPlot = () => {
                if (window.Plotly) {
                    Plotly.purge(plotHost);
                }

                plotHost.replaceChildren();
            };

            const syncChartControls = () => {
                const isPdf = chartTypeSelect?.value === 'pdf';
                xFieldLabel.textContent = isPdf ? 'Riferimento tooltip' : 'Asse X';
                seriesFieldsLabel.textContent = isPdf ? 'Grandezze da analizzare' : 'Colonne asse Y';

                if (isPdf) {
                    if (!xFieldSelect.disabled) {
                        scatterXField = xFieldSelect.value;
                    }

                    const subjectKeyOption = Array.from(xFieldSelect.options)
                        .find(option => option.value === 'SubjectKey');
                    if (subjectKeyOption) {
                        xFieldSelect.value = subjectKeyOption.value;
                    }

                    xFieldSelect.disabled = true;
                } else {
                    xFieldSelect.disabled = false;
                    if (scatterXField && Array.from(xFieldSelect.options)
                        .some(option => option.value === scatterXField)) {
                        xFieldSelect.value = scatterXField;
                    }
                }
            };

            chartTypeSelect.addEventListener('change', syncChartControls);
            syncChartControls();

            if (resetPlotButton) {
                resetPlotButton.addEventListener('click', () => {
                    if (activePlotRequest) {
                        activePlotRequest.abort();
                        activePlotRequest = null;
                    }

                    plotRequestSequence++;
                    form.reset();
                    scatterXField = xFieldSelect.value;
                    syncChartControls();
                    document.querySelectorAll('.plot-row-selector')
                        .forEach(checkbox => checkbox.checked = false);
                    if (selectAll) {
                        selectAll.checked = false;
                    }

                    clearPlot();
                    setStatus('');
                    setPlotLoading(false);
                    plotModalTitle.textContent = 'Scatter';
                    plotModal.hide();
                });
            }

            const setPlotLoading = isLoading => {
                plotFrame.classList.toggle('is-loading', isLoading);
                form.querySelectorAll('button, input, select').forEach(control => {
                    control.disabled = isLoading;
                });
                if (!isLoading) {
                    syncChartControls();
                }
            };

            const getAxisTitleText = axis => {
                if (!axis || !axis.title) {
                    return '';
                }

                return typeof axis.title === 'string'
                    ? axis.title
                    : axis.title.text || '';
            };

            form.addEventListener('submit', async event => {
                event.preventDefault();
                plotModal.show();
                const formData = new FormData(form);
                const chartType = formData.get('chartType') === 'pdf' ? 'pdf' : 'scatter';
                const chartLabel = chartType === 'pdf' ? 'PDF' : 'Scatter';
                const requestId = ++plotRequestSequence;
                plotModalTitle.textContent = chartLabel;

                if (!window.Plotly) {
                    setStatus('Plotly.js non e disponibile. Installare wwwroot/lib/plotly/plotly.min.js.', true);
                    return;
                }

                const selectedSeriesFields = form.querySelectorAll('select[name="seriesFields"] option:checked');
                if (selectedSeriesFields.length === 0) {
                    setStatus('Selezionare almeno una grandezza da analizzare.', true);
                    clearPlot();
                    return;
                }

                if (activePlotRequest) {
                    activePlotRequest.abort();
                }

                activePlotRequest = new AbortController();
                clearPlot();
                setPlotLoading(true);
                setStatus(`Generazione ${chartLabel} in corso...`);

                try {
                    const response = await fetch(`${form.action}?${new URLSearchParams(formData)}`, {
                        headers: { 'Accept': 'application/json' },
                        signal: activePlotRequest.signal
                    });

                    const payload = await response.json();
                    if (!response.ok) {
                        throw new Error(payload.message || 'Errore durante la generazione del grafico.');
                    }

                    if (requestId !== plotRequestSequence) {
                        return;
                    }

                    const layout = {
                        ...payload.layout,
                        paper_bgcolor: '#ffffff',
                        plot_bgcolor: '#ffffff',
                        font: { color: '#24292f' },
                        margin: { l: 96, r: 32, t: 64, b: 96 },
                        xaxis: {
                            ...payload.layout.xaxis,
                            automargin: true,
                            linecolor: '#57606a',
                            gridcolor: '#d8dee4',
                            zerolinecolor: '#d0d7de',
                            tickfont: { color: '#24292f' },
                            title: {
                                text: getAxisTitleText(payload.layout.xaxis),
                                font: { color: '#24292f', size: 14 },
                                standoff: 22
                            }
                        },
                        yaxis: {
                            ...payload.layout.yaxis,
                            automargin: true,
                            linecolor: '#57606a',
                            gridcolor: '#d8dee4',
                            zerolinecolor: '#d0d7de',
                            tickfont: { color: '#24292f' },
                            title: {
                                text: getAxisTitleText(payload.layout.yaxis),
                                font: { color: '#24292f', size: 14 },
                                standoff: 28
                            }
                        },
                        legend: {
                            orientation: 'h',
                            y: -0.2,
                            font: { color: '#24292f' }
                        }
                    };

                    await Plotly.react(plotHost, payload.traces, layout, {
                        responsive: true,
                        displaylogo: false
                    });
                    Plotly.Plots.resize(plotHost);
                    setStatus(`${chartLabel} generato su ${payload.rowCount} righe filtrate.`);
                } catch (error) {
                    if (error.name === 'AbortError') {
                        return;
                    }

                    clearPlot();
                    setStatus(error.message || 'Errore durante la generazione del grafico.', true);
                } finally {
                    if (requestId === plotRequestSequence) {
                        setPlotLoading(false);
                        activePlotRequest = null;
                    }
                }
            });

            plotModalElement.addEventListener('shown.bs.modal', () => {
                if (window.Plotly) {
                    Plotly.Plots.resize(plotHost);
                }
            });
        })();
    </script>
}
