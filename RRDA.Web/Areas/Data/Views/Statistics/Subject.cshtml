@{
    ViewData["Title"] = "Analisi statistiche";
}

<h4>Analisi statistiche - reportTypeId @ViewBag.ReportTypeId</h4>
<p style="color:#8b949e">
    Vista ausiliaria pronta per integrare: statistiche base, distribuzioni e correlazioni.
</p>
<ul>
    <li>Statistiche base (media, mediana, min, max, deviazione standard)</li>
    <li>Distribuzioni (istogrammi, percentili)</li>
    <li>Correlazioni tra misure numeriche</li>
</ul>
