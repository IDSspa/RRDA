@model RRDA.Web.Areas.Data.Controllers.DistributionViewModel
@{
    ViewData["Title"] = $"Distribuzione - {Model.Field}";
    var maxCount = Model.Bins.Any() ? Model.Bins.Max(b => b.Count) : 1;
}

<h4>Distribuzione: @Model.Field</h4>
<p style="color:#8b949e;">Campioni numerici: @Model.Samples</p>

@if (!Model.Bins.Any())
{
    <p style="color:#8b949e;">Nessun dato numerico disponibile.</p>
}
else
{
    <table class="table table-borderless">
        <thead><tr><th>Intervallo</th><th>Conteggio</th><th>Grafico</th></tr></thead>
        <tbody>
            @foreach (var b in Model.Bins)
            {
                var w = maxCount == 0 ? 0 : (int)Math.Round((b.Count * 100.0) / maxCount);
                <tr>
                    <td style="font-family:monospace;">[@b.From.ToString("0.###") ; @b.To.ToString("0.###")]</td>
                    <td>@b.Count</td>
                    <td><div style="height:12px;background:#1f6feb;width:@w%;min-width:2px;"></div></td>
                </tr>
            }
        </tbody>
    </table>
}