<?xml version="1.0" encoding="utf-8"?>
<ImportBanList version="1"
               matchMode="glob"
               caseSensitive="false">
  <DefinedNames>
    <!-- Nomi riservati Excel moderni e varianti prodotte da alcuni provider. -->
    <Pattern>_xlnm.*</Pattern>
    <Pattern>__xlnm*</Pattern>
    <Pattern>_xl.*</Pattern>
    <Pattern>__xl.*</Pattern>

    <!-- Nomi legacy Excel 97-2003 senza prefisso riservato. -->
    <Pattern>Print_Area</Pattern>
    <Pattern>Print_Titles</Pattern>
    <Pattern>Filter_Database</Pattern>
    <Pattern>_FilterDatabase</Pattern>
	<Pattern>Esito_Finale_No</Pattern>
	<Pattern>Esito_Finale_Si</Pattern>
	<Pattern>Allegato*</Pattern>
  </DefinedNames>
	<Sheets>
		<Pattern>Evoluzione_doc</Pattern>
		<Pattern>Note_di_collaudo</Pattern>
		<Pattern>Fig*</Pattern>
	</Sheets>
</ImportBanList>
