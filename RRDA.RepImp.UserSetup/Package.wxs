<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="RRDA RepImp User Setup"
           Manufacturer="IDS"
           Version="$(var.InstallerVersion)"
           Scope="perUser"
           UpgradeCode="b27871c0-77b8-48c4-a5ce-d862cd6af30f">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Una versione piu recente di [ProductName] e gia installata per questo utente." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="RepImpIcon" SourceFile="..\RRDA.RepImp\Assets\RepImp.ico" />
    <Property Id="ARPPRODUCTICON" Value="RepImpIcon" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="..\RRDA.RepImp.Setup\License.rtf" />

    <Feature Id="MainFeature" Title="RRDA RepImp" Level="1">
      <ComponentGroupRef Id="PublishedApplicationFiles" />
      <ComponentGroupRef Id="PublishedPluginFiles" />
      <ComponentGroupRef Id="DatabaseScripts" />
      <ComponentGroupRef Id="ApplicationShortcuts" />
    </Feature>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="IDSFOLDER" Name="IDS">
        <Directory Id="INSTALLFOLDER" Name="RRDA RepImp">
          <Directory Id="PLUGINSFOLDER" Name="plugins" />
          <Directory Id="DATABASEFOLDER" Name="Database" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="RRDA RepImp" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="PublishedApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)**" />
    </ComponentGroup>

    <ComponentGroup Id="PublishedPluginFiles" Directory="PLUGINSFOLDER">
      <Files Include="$(var.PluginsDir)RRDA.Plugins.*.dll" />
    </ComponentGroup>

    <ComponentGroup Id="DatabaseScripts" Directory="DATABASEFOLDER">
      <Files Include="$(var.DatabaseDir)RRDA.Db.Migrations.sql" />
    </ComponentGroup>

    <ComponentGroup Id="ApplicationShortcuts">
      <Component Id="StartMenuShortcutComponent"
                 Directory="ApplicationProgramsFolder"
                 Guid="ca6de5b1-a428-4dc7-9f8e-d97827927d91">
        <Shortcut Id="StartMenuShortcut"
                  Name="RRDA RepImp"
                  Description="Avvia RRDA RepImp"
                  Target="[INSTALLFOLDER]RRDA.RepImp.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\IDS\RRDA\RepImp"
                       Name="UserStartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcutComponent"
                 Directory="DesktopFolder"
                 Guid="7f52729f-1e5e-4baa-8a0a-e361ea80df87">
        <Shortcut Id="DesktopShortcut"
                  Name="RRDA RepImp"
                  Description="Avvia RRDA RepImp"
                  Target="[INSTALLFOLDER]RRDA.RepImp.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\IDS\RRDA\RepImp"
                       Name="UserDesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
